-- Measure: SVG - Header The Edge
-- Report: Trading Analytics (The Book · The Edge · The Desk)
-- Table: gold_fact_trades
-- Display folder: 08-page2-layout

VAR _svg =
    "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1792 96' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif'>"
        & "<text x='0' y='46' font-size='38' font-weight='800' letter-spacing='-1' fill='#0F1712'>The Edge</text>"
        & "<text x='2' y='78' font-size='15' fill='#6A746C'>Where do the wins and losses come from? · R-multiples · exits · " & FORMAT ( [Strategies], "0" ) & " strategies</text>"
        & "<rect x='1290' y='26' width='170' height='42' rx='21' fill='#FFFFFF' stroke='#E3E8E3'/>"
        & "<circle cx='1314' cy='47' r='5' fill='#4ED15A'/><text x='1328' y='52' font-size='14' font-weight='600' fill='#0F1712'>Alpaca · Paper</text>"
        & "<rect x='1472' y='26' width='150' height='42' rx='21' fill='#0F1712'/><text x='1490' y='52' font-size='14' font-weight='600' fill='#FFFFFF'>Last 10 weeks  ⌄</text>"
        & "<rect x='1634' y='26' width='158' height='42' rx='21' fill='#0F1712'/><text x='1652' y='52' font-size='14' font-weight='600' fill='#FFFFFF'>All strategies  ⌄</text>"
        & "</svg>"
RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #
