    MEASURE gold_fact_trades[SVG - Header The Edge] =
        VAR _chip = FORMAT ( [First Trade Date], "d mmm", "en-US" ) & " – " & FORMAT ( [Last Trade Date], "d mmm yyyy", "en-US" )
        VAR _cw = 28 + LEN ( _chip ) * 8.2
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1792 96' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif'>"
                & "<text x='0' y='48' font-family='Georgia,Cambria,Times New Roman,serif' font-size='42' font-weight='700' letter-spacing='-.5' fill='#0F1712'>The Edge</text>"
                & "<text x='2' y='80' font-size='15' fill='#5E685F'>" & "Where do the wins and losses come from? · R-multiples · exits · " & FORMAT ( [Strategies], "0" ) & " strategies" & "</text>"
                & "<rect x='" & FORMAT ( 1792 - _cw - 186, "0", "en-US" ) & "' y='26' width='174' height='42' rx='21' fill='#FFFFFF' stroke='#E3E8E3'/>"
                & "<circle cx='" & FORMAT ( 1792 - _cw - 164, "0", "en-US" ) & "' cy='47' r='5' fill='#F2B33D'/>"
                & "<text x='" & FORMAT ( 1792 - _cw - 150, "0", "en-US" ) & "' y='52' font-size='14' font-weight='700' fill='#0F1712'>Alpaca · Paper</text>"
                & "<rect x='" & FORMAT ( 1792 - _cw, "0", "en-US" ) & "' y='26' width='" & FORMAT ( _cw, "0", "en-US" ) & "' height='42' rx='21' fill='#0F1712'/>"
                & "<text x='" & FORMAT ( 1792 - _cw / 2, "0", "en-US" ) & "' y='52' font-size='14' font-weight='700' text-anchor='middle' fill='#FFFFFF'>" & _chip & "</text>"
                & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Card Strategy Lollipop] =
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 884 340' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif'>"
                & "<rect width='884' height='340' rx='20' fill='#FFFFFF' stroke='{HAIR}'/>"
                & "<text x='28' y='44' font-family='Georgia,Cambria,Times New Roman,serif' font-size='23' font-weight='700' fill='#0F1712'>" & "Tagged setups earn · untagged legacy bleeds" & "</text>"
                & "<text x='28' y='68' font-size='13' fill='#5E685F'>" & "Net P&amp;L of the 4 best and 4 worst of " & FORMAT ( [Strategies], "0" ) & " strategies · dot size = number of trades" & "</text>"
                & "<rect x='726' y='22' width='130' height='26' rx='13' fill='#EEF2EE'/><text x='791.0' y='39.0' font-size='12' font-weight='700' text-anchor='middle' fill='#5E685F'>" & "4 best · 4 worst" & "</text>"
                & "<svg x='28' y='92' width='828' height='228'>" & SUBSTITUTE ( SUBSTITUTE ( MID ( [SVG - Strategy Lollipop], 25, 100000 ), "%23", "#" ), "%25", "%" ) & "</svg>"
                & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Card R-Multiple Dots] =
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 884 358' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif'>"
                & "<rect width='884' height='358' rx='20' fill='#FFFFFF' stroke='{HAIR}'/>"
                & "<text x='28' y='44' font-family='Georgia,Cambria,Times New Roman,serif' font-size='23' font-weight='700' fill='#0F1712'>" & "Every dot is a trade · losses pile up past the stop" & "</text>"
                & "<text x='28' y='68' font-size='13' fill='#5E685F'>" & "Trades with a defined stop, grouped by R-multiple (net P&amp;L ÷ planned risk)" & "</text>"
                & "<rect x='686' y='22' width='170' height='26' rx='13' fill='#FDE7E4'/><text x='771.0' y='39.0' font-size='12' font-weight='700' text-anchor='middle' fill='#C9402F'>" & FORMAT ( [Lost Past -1R Trades], "0" ) & " slipped the stop" & "</text>"
                & "<svg x='28' y='92' width='828' height='246'>" & SUBSTITUTE ( SUBSTITUTE ( MID ( [SVG - R-Multiple Dots], 25, 100000 ), "%23", "#" ), "%25", "%" ) & "</svg>"
                & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Card Shorts vs Longs] =
        -- dark card: short vs long scorecards + one tick per trade
        VAR _sp = [Short P&L]  VAR _lp = [Long P&L]
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 884 358' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif'>"
                & "<rect width='884' height='358' rx='20' fill='#0F1712'/>"
                & "<text x='28' y='44' font-family='Georgia,Cambria,Times New Roman,serif' font-size='23' font-weight='700' fill='#FFFFFF'>" & IF ( _sp > _lp, "Shorts carry the book", "Longs carry the book" ) & "</text>"
                & "<text x='28' y='68' font-size='13' fill='rgba(255,255,255,.6)'>Net P&amp;L and win rate by side</text>"
                & "<rect x='776' y='22' width='80' height='26' rx='13' fill='#FFFFFF'/><text x='816' y='39' font-size='12' font-weight='700' text-anchor='middle' fill='#0F1712'>By side</text>"
                & "<rect x='28' y='84' width='404' height='104' rx='16' fill='#1B2A20'/>"
                & "<text x='48' y='112' font-size='12' fill='rgba(255,255,255,.6)'>Short · " & FORMAT ( [Short Trades], "0" ) & "</text>"
                & "<text x='48' y='152' font-size='34' font-weight='800' fill='" & IF ( _sp >= 0, "#4ED15A", "#C9402F" ) & "'>" & FORMAT ( _sp, "+$#,0;-$#,0", "en-US" ) & "</text>"
                & "<text x='48' y='174' font-size='12' fill='rgba(255,255,255,.6)'>" & FORMAT ( [Short Win Rate], "0%" ) & " win</text>"
                & "<rect x='452' y='84' width='404' height='104' rx='16' fill='#1B2A20'/>"
                & "<text x='472' y='112' font-size='12' fill='rgba(255,255,255,.6)'>Long · " & FORMAT ( [Long Trades], "0" ) & "</text>"
                & "<text x='472' y='152' font-size='34' font-weight='800' fill='" & IF ( _lp >= 0, "#4ED15A", "#C9402F" ) & "'>" & FORMAT ( _lp, "+$#,0;-$#,0", "en-US" ) & "</text>"
                & "<text x='472' y='174' font-size='12' fill='rgba(255,255,255,.6)'>" & FORMAT ( [Long Win Rate], "0%" ) & " win</text>"
                & "<svg x='28' y='206' width='828' height='104'>" & SUBSTITUTE ( SUBSTITUTE ( MID ( [SVG - Long vs Short Units], 25, 100000 ), "%23", "#" ), "%25", "%" ) & "</svg>"
                & "<text x='28' y='338' font-size='11' fill='rgba(255,255,255,.55)'>" & FORMAT ( [Long Share of Trades], "0%" ) & " of trades are long — " & IF ( _lp < _sp, "the losing side", "the winning side" ) & "</text>"
                & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Header The Desk] =
        VAR _chip = "As of " & FORMAT ( CALCULATE ( MAX ( gold_fact_account[Date] ), REMOVEFILTERS ( gold_dim_date ) ), "d mmm yyyy", "en-US" )
        VAR _cw = 28 + LEN ( _chip ) * 8.2
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1792 96' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif'>"
                & "<text x='0' y='48' font-family='Georgia,Cambria,Times New Roman,serif' font-size='42' font-weight='700' letter-spacing='-.5' fill='#0F1712'>The Desk</text>"
                & "<text x='2' y='80' font-size='15' fill='#5E685F'>" & "What is open right now? · positions · cash · order flow" & "</text>"
                & "<rect x='" & FORMAT ( 1792 - _cw - 186, "0", "en-US" ) & "' y='26' width='174' height='42' rx='21' fill='#FFFFFF' stroke='#E3E8E3'/>"
                & "<circle cx='" & FORMAT ( 1792 - _cw - 164, "0", "en-US" ) & "' cy='47' r='5' fill='#F2B33D'/>"
                & "<text x='" & FORMAT ( 1792 - _cw - 150, "0", "en-US" ) & "' y='52' font-size='14' font-weight='700' fill='#0F1712'>Alpaca · Paper</text>"
                & "<rect x='" & FORMAT ( 1792 - _cw, "0", "en-US" ) & "' y='26' width='" & FORMAT ( _cw, "0", "en-US" ) & "' height='42' rx='21' fill='#0F1712'/>"
                & "<text x='" & FORMAT ( 1792 - _cw / 2, "0", "en-US" ) & "' y='52' font-size='14' font-weight='700' text-anchor='middle' fill='#FFFFFF'>" & _chip & "</text>"
                & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Card Positions Treemap] =
        -- strip treemap sized to the card: tile width = market value, colour = return on cost
        VAR _p = ADDCOLUMNS ( VALUES ( gold_fact_positions[symbol] ), "@mv", [Position Market Value], "@r", [Position Return %] )
        VAR _tot = SUMX ( _p, [@mv] )
        VAR _rk = ADDCOLUMNS ( _p, "@i", RANKX ( _p, [@mv], , DESC, DENSE ) )
        VAR _x = ADDCOLUMNS ( _rk, "@x0", VAR i = [@i] RETURN 28 + SUMX ( FILTER ( _rk, [@i] < i ), [@mv] ) / _tot * 828 )
        VAR _tiles = CONCATENATEX ( _x,
            VAR w = [@mv] / _tot * 828
            VAR c = IF ( [@r] >= 0.01, "#23803A", IF ( [@r] >= 0, "#A9E5AE", IF ( [@r] > -0.01, "#F2B5AE", "#C9402F" ) ) )
            VAR tc = IF ( ABS ( [@r] ) >= 0.01, "#FFFFFF", "#0F1712" )
            RETURN
                "<rect x='" & FORMAT ( [@x0] + 2, "0.0", "en-US" ) & "' y='96' width='" & FORMAT ( MAX ( w - 4, 1 ), "0.0", "en-US" ) & "' height='212' rx='10' fill='" & c & "'/>"
                & IF ( w >= 9 * LEN ( gold_fact_positions[symbol] ) + 24,
                    "<text x='" & FORMAT ( [@x0] + 12, "0.0", "en-US" ) & "' y='120' font-size='14' font-weight='800' fill='" & tc & "'>" & gold_fact_positions[symbol] & "</text>"
                    & "<text x='" & FORMAT ( [@x0] + 12, "0.0", "en-US" ) & "' y='137' font-size='12' fill='" & tc & "' fill-opacity='.85'>" & FORMAT ( [@mv], "$#,0", "en-US" ) & " · " & FORMAT ( DIVIDE ( [@mv], _tot ), "0%" ) & "</text>"
                    & "<text x='" & FORMAT ( [@x0] + w - 10, "0.0", "en-US" ) & "' y='296' font-size='14' font-weight='800' text-anchor='end' fill='" & tc & "'>" & FORMAT ( [@r], "+0.00%;-0.00%", "en-US" ) & "</text>" ),
            "", [@i], ASC )
        VAR _small = COUNTROWS ( FILTER ( _x, [@mv] / _tot * 828 < 9 * LEN ( gold_fact_positions[symbol] ) + 24 ) )
        VAR _smallList = CONCATENATEX ( FILTER ( _x, [@mv] / _tot * 828 < 9 * LEN ( gold_fact_positions[symbol] ) + 24 ), gold_fact_positions[symbol] & " " & FORMAT ( [@r], "+0.0%;-0.0%", "en-US" ), " · ", [@i], ASC )
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 884 340' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif'>"
                & "<rect width='884' height='340' rx='20' fill='#FFFFFF' stroke='#E3E8E3'/>"
                & "<text x='28' y='44' font-family='Georgia,Cambria,Times New Roman,serif' font-size='23' font-weight='700' fill='#0F1712'>Open positions · " & IF ( [Top Position Share] >= 0.3, "one name carries the gain", "exposure is spread out" ) & "</text>"
                & "<text x='28' y='68' font-size='13' fill='#5E685F'>Tile area = market value · colour = return on cost · " & FORMAT ( [Open Positions], "0" ) & " open positions</text>"
                & "<rect x='700' y='30' width='14' height='10' rx='2' fill='#C9402F'/><rect x='716' y='30' width='14' height='10' rx='2' fill='#F2B5AE'/>"
                & "<rect x='732' y='30' width='14' height='10' rx='2' fill='#A9E5AE'/><rect x='748' y='30' width='14' height='10' rx='2' fill='#23803A'/>"
                & "<text x='770' y='39' font-size='11' fill='#5E685F'>−1% → +1%</text>"
                & _tiles
                & IF ( _small > 0, "<text x='28' y='328' font-size='12' fill='#5E685F'>+" & _small & " smaller: " & _smallList & "</text>" )
                & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Card Order Flow] =
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 884 358' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif'>"
                & "<rect width='884' height='358' rx='20' fill='#FFFFFF' stroke='#E3E8E3'/>"
                & "<text x='28' y='44' font-family='Georgia,Cambria,Times New Roman,serif' font-size='23' font-weight='700' fill='#0F1712'>Where " & FORMAT ( [Orders], "#,0", "en-US" ) & " orders went</text>"
                & "<text x='28' y='68' font-size='13' fill='#5E685F'>Order flow: all orders → side → outcome · band width = order count</text>"
                & "<rect x='686' y='22' width='170' height='26' rx='13' fill='#E3F5E5'/><text x='771' y='39' font-size='12' font-weight='700' text-anchor='middle' fill='#23803A'>" & FORMAT ( [Cancel Rate], "0%" ) & " cancelled · expected</text>"
                & "<svg x='28' y='88' width='828' height='252'>" & SUBSTITUTE ( SUBSTITUTE ( MID ( [SVG - Order Flow Sankey], 25, 100000 ), "%23", "#" ), "%25", "%" ) & "</svg>"
                & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Card Market Coverage] =
        -- dark card: price coverage bars + one chip per crypto base (green = has daily bars on Alpaca)
        VAR _priced = CALCULATETABLE ( VALUES ( gold_fact_prices_daily[symbol] ), REMOVEFILTERS ( gold_dim_date ), gold_fact_prices_daily[asset_class] = "crypto" )
        VAR _bases = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( gold_dim_symbol[base] ), gold_dim_symbol[asset_class] = "crypto" ),
            "@ok", IF ( CONTAINS ( _priced, gold_fact_prices_daily[symbol], gold_dim_symbol[base] & "USD" ), 1, 0 ) )
        VAR _n = COUNTROWS ( _bases )
        VAR _ok = SUMX ( _bases, [@ok] )
        VAR _rk = ADDCOLUMNS ( _bases, "@i", RANKX ( _bases, gold_dim_symbol[base], , ASC, DENSE ) - 1 )
        VAR _chips = CONCATENATEX ( _rk,
            VAR cx = 28 + MOD ( [@i], 12 ) * 69
            VAR cy = 168 + INT ( [@i] / 12 ) * 30
            VAR c = IF ( [@ok] = 1, "#4ED15A", "#C9402F" )
            RETURN "<rect x='" & cx & "' y='" & cy & "' width='62' height='22' rx='6' fill='none' stroke='" & c & "' stroke-opacity='.7'/>"
                & "<text x='" & ( cx + 31 ) & "' y='" & ( cy + 15 ) & "' font-size='12' font-weight='700' text-anchor='middle' fill='" & c & "'>" & LEFT ( gold_dim_symbol[base], 7 ) & "</text>",
            "", [@i], ASC )
        VAR _eqw = 520 * DIVIDE ( [Equities Priced], [Equities Tracked] )
        VAR _crw = 520 * DIVIDE ( _ok, _n )
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 884 358' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif'>"
                & "<rect width='884' height='358' rx='20' fill='#0F1712'/>"
                & "<text x='28' y='44' font-family='Georgia,Cambria,Times New Roman,serif' font-size='23' font-weight='700' fill='#FFFFFF'>Market coverage</text>"
                & "<text x='28' y='68' font-size='13' fill='rgba(255,255,255,.6)'>Symbols with daily price bars on Alpaca</text>"
                & "<rect x='756' y='22' width='100' height='26' rx='13' fill='#FFFFFF'/><text x='806' y='39' font-size='12' font-weight='700' text-anchor='middle' fill='#0F1712'>Daily bars</text>"
                & "<text x='28' y='104' font-size='13' font-weight='700' fill='#FFFFFF'>Equities</text>"
                & "<rect x='130' y='96' width='520' height='9' rx='4.5' fill='rgba(255,255,255,.12)'/><rect x='130' y='96' width='" & FORMAT ( _eqw, "0", "en-US" ) & "' height='9' rx='4.5' fill='#4ED15A'/>"
                & "<text x='856' y='104' font-size='13' font-weight='700' text-anchor='end' fill='#4ED15A'>" & [Equities Priced] & "/" & [Equities Tracked] & "</text>"
                & "<text x='28' y='134' font-size='13' font-weight='700' fill='#FFFFFF'>Crypto</text>"
                & "<rect x='130' y='126' width='520' height='9' rx='4.5' fill='rgba(255,255,255,.12)'/><rect x='130' y='126' width='" & FORMAT ( _crw, "0", "en-US" ) & "' height='9' rx='4.5' fill='#C9402F'/>"
                & "<text x='856' y='134' font-size='13' font-weight='700' text-anchor='end' fill='#C9402F'>" & _ok & "/" & _n & "</text>"
                & _chips
                & "<text x='28' y='340' font-size='11' fill='rgba(255,255,255,.55)'>" & ( _n - _ok ) & " crypto pairs have no Alpaca bars · backfill them from Binance once it's enabled</text>"
                & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Cover] =
        -- page 0 (1920 x 1080): title, three headline numbers, how-to-read strip and a hero drawn from the
        -- real daily equity path (one candle per trading day: open = previous cumulative P&L, close = today's)
        VAR _t = ADDCOLUMNS ( FILTER ( ALLSELECTED ( gold_dim_date[Date] ), NOT ISBLANK ( [Net P&L] ) ), "@cum", [Cumulative P&L], "@day", [Net P&L] )
        VAR _n = COUNTROWS ( _t )
        VAR _hi = MAXX ( _t, MAX ( [@cum], [@cum] - [@day] ) )  VAR _lo = MINX ( _t, MIN ( [@cum], [@cum] - [@day] ) )
        VAR _r = ADDCOLUMNS ( _t, "@i", RANKX ( _t, gold_dim_date[Date], , ASC ) )
        VAR _cw = 860 / _n
        VAR _candles = CONCATENATEX ( _r,
            VAR x = 1000 + ( [@i] - 1 ) * _cw
            VAR o = 200 + ( _hi - ( [@cum] - [@day] ) ) / ( _hi - _lo ) * 420
            VAR c = 200 + ( _hi - [@cum] ) / ( _hi - _lo ) * 420
            VAR k = IF ( [@day] >= 0, "#4ED15A", "#C9402F" )
            RETURN "<line x1='" & FORMAT ( x + _cw / 2, "0.0", "en-US" ) & "' x2='" & FORMAT ( x + _cw / 2, "0.0", "en-US" ) & "' y1='" & FORMAT ( MIN ( o, c ) - 8, "0.0", "en-US" ) & "' y2='" & FORMAT ( MAX ( o, c ) + 8, "0.0", "en-US" ) & "' stroke='" & k & "' stroke-opacity='.45'/>"
                & "<rect x='" & FORMAT ( x + 2, "0.0", "en-US" ) & "' y='" & FORMAT ( MIN ( o, c ), "0.0", "en-US" ) & "' width='" & FORMAT ( MAX ( _cw - 4, 2 ), "0.0", "en-US" ) & "' height='" & FORMAT ( MAX ( ABS ( c - o ), 2 ), "0.0", "en-US" ) & "' rx='2' fill='" & k & "' fill-opacity='.8'/>",
            "", [@i], ASC )
        VAR _z = 200 + _hi / ( _hi - _lo ) * 420
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1920 1080' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif'>"
                & "<defs><radialGradient id='g' cx='75%' cy='35%' r='70%'><stop offset='0' stop-color='#1B2A20'/><stop offset='1' stop-color='#0F1712'/></radialGradient>"
                & "<pattern id='p' width='24' height='24' patternUnits='userSpaceOnUse'><path d='M24 0 H0 V24' fill='none' stroke='#fff' stroke-opacity='.035'/></pattern></defs>"
                & "<rect width='1920' height='1080' fill='url(#g)'/><rect width='1920' height='1080' fill='url(#p)'/>"
                & "<line x1='1000' x2='1860' y1='" & FORMAT ( _z, "0.0", "en-US" ) & "' y2='" & FORMAT ( _z, "0.0", "en-US" ) & "' stroke='#fff' stroke-opacity='.25' stroke-dasharray='3 6'/>"
                & "<text x='1860' y='" & FORMAT ( _z - 10, "0.0", "en-US" ) & "' font-size='14' text-anchor='end' fill='#fff' fill-opacity='.5'>$0 · start of book</text>"
                & _candles
                & "<text x='1000' y='680' font-size='14' fill='#fff' fill-opacity='.5'>One candle per trading day · cumulative closed P&amp;L · " & FORMAT ( _n, "0" ) & " days</text>"
                & "<rect x='120' y='96' width='52' height='52' rx='14' fill='#4ED15A'/>"
                & "<polyline points='132,132 142,120 151,127 162,113' fill='none' stroke='#0F1712' stroke-width='3.5' stroke-linecap='round' stroke-linejoin='round'/>"
                & "<text x='188' y='131' font-size='22' font-weight='800' fill='#fff'>DataPat<tspan fill='#4ED15A'>.ai</tspan></text>"
                & "<text x='120' y='300' font-size='15' font-weight='800' letter-spacing='3' fill='#F2B33D'>ALPACA · PAPER ACCOUNT · " & UPPER ( FORMAT ( [First Trade Date], "d mmm", "en-US" ) & " – " & FORMAT ( [Last Trade Date], "d mmm yyyy", "en-US" ) ) & "</text>"
                & "<text x='116' y='392' font-family='Georgia,Cambria,Times New Roman,serif' font-size='88' font-weight='700' fill='#fff'>The Book of a</text>"
                & "<text x='116' y='488' font-family='Georgia,Cambria,Times New Roman,serif' font-size='88' font-weight='700' font-style='italic' fill='#4ED15A'>Paper Trader</text>"
                & "<text x='120' y='548' font-size='22' fill='#fff' fill-opacity='.72'>" & FORMAT ( [Trades], "#,0" ) & " closed trades, " & FORMAT ( [Strategies], "0" ) & " strategies and one honest question: is there an edge?</text>"
                & "<g fill='#fff'>"
                & "<text x='120' y='628' font-size='13' font-weight='800' letter-spacing='2' fill-opacity='.55'>ACCOUNT EQUITY</text>"
                & "<text x='120' y='692' font-size='60' font-weight='800' letter-spacing='-1'>" & FORMAT ( [Account Equity], "$#,0", "en-US" ) & "</text>"
                & "<text x='420' y='628' font-size='13' font-weight='800' letter-spacing='2' fill-opacity='.55'>NET CLOSED P&amp;L</text>"
                & "<text x='420' y='692' font-size='60' font-weight='800' letter-spacing='-1' fill='" & IF ( [Net P&L] < 0, "#FF7A6E", "#4ED15A" ) & "'>" & FORMAT ( [Net P&L], "+$#,0;-$#,0", "en-US" ) & "</text>"
                & "<text x='700' y='628' font-size='13' font-weight='800' letter-spacing='2' fill-opacity='.55'>PROFIT FACTOR</text>"
                & "<text x='700' y='692' font-size='60' font-weight='800' letter-spacing='-1'>" & FORMAT ( [Profit Factor], "0.00", "en-US" ) & "</text></g>"
                & "<rect x='120' y='744' width='300' height='64' rx='32' fill='#4ED15A'/>"
                & "<text x='270' y='784' font-size='20' font-weight='800' text-anchor='middle' fill='#0F1712'>Explore the book  →</text>"
                & "<rect x='440' y='744' width='170' height='64' rx='32' fill='none' stroke='#fff' stroke-opacity='.4'/>"
                & "<text x='525' y='784' font-size='18' font-weight='700' text-anchor='middle' fill='#fff'>LinkedIn ↗</text>"
                & "<rect x='626' y='744' width='170' height='64' rx='32' fill='none' stroke='#fff' stroke-opacity='.4'/>"
                & "<text x='711' y='784' font-size='18' font-weight='700' text-anchor='middle' fill='#fff'>Portfolio ↗</text>"
                & "<line x1='120' x2='1800' y1='880' y2='880' stroke='#fff' stroke-opacity='.15'/>"
                & "<text x='120' y='920' font-size='13' font-weight='800' letter-spacing='2' fill='#F2B33D'>HOW TO READ</text>"
                & "<text x='120' y='962' font-size='18' font-weight='800' fill='#fff'>R-multiple</text>"
                & "<text x='120' y='992' font-size='16' fill='#fff' fill-opacity='.68'>Net P&amp;L ÷ planned risk. +1R = won what you risked;</text>"
                & "<text x='120' y='1016' font-size='16' fill='#fff' fill-opacity='.68'>past −1R = the stop slipped.</text>"
                & "<text x='700' y='962' font-size='18' font-weight='800' fill='#fff'>Profit factor</text>"
                & "<text x='700' y='992' font-size='16' fill='#fff' fill-opacity='.68'>Gross wins ÷ gross losses. Above 1.00 makes money,</text>"
                & "<text x='700' y='1016' font-size='16' fill='#fff' fill-opacity='.68'>below 1.00 loses it.</text>"
                & "<text x='1280' y='962' font-size='18' font-weight='800' fill='#F2B33D'>Why “PAPER” matters</text>"
                & "<text x='1280' y='992' font-size='16' fill='#fff' fill-opacity='.68'>Simulated fills on Alpaca’s paper account: no real</text>"
                & "<text x='1280' y='1016' font-size='16' fill='#fff' fill-opacity='.68'>capital, no slippage cost. Treat results as a rehearsal.</text>"
                & "<text x='1800' y='131' font-size='15' text-anchor='end' fill='#fff' fill-opacity='.6'>Patricio Rios · Microsoft Fabric + Power BI</text>"
                & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Rail The Ledger] =
        -- left navigation rail · active item = Ledger (green pill); a transparent vertical
        -- Page navigator (x 0, y 96, 72 x 380, 5 buttons of 76px) sits on top and does the actual navigation
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 72 1080' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif'>"
                & "<rect width='72' height='1080' fill='#0F1712'/>"
                & "<rect x='14' y='24' width='44' height='44' rx='12' fill='#4ED15A'/>"
                & "<polyline points='24,54 32,44 40,50 49,38' fill='none' stroke='#0F1712' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/>"
                & "<path d='M26 126 L36 116 L46 126 V135 H26 Z' fill='none' stroke='rgba(255,255,255,.55)' stroke-width='2' stroke-linejoin='round'/><text x='36' y='156' font-size='11' font-weight='600' text-anchor='middle' fill='rgba(255,255,255,.62)'>Home</text><polyline points='26,196 32,208 38,200 46,192' fill='none' stroke='rgba(255,255,255,.55)' stroke-width='2' stroke-linecap='round'/><line x1='26' y1='210' x2='46' y2='210' stroke='rgba(255,255,255,.55)' stroke-width='2'/><text x='36' y='232' font-size='11' font-weight='600' text-anchor='middle' fill='rgba(255,255,255,.62)'>Book</text><circle cx='36' cy='278' r='10' fill='none' stroke='rgba(255,255,255,.55)' stroke-width='2'/><circle cx='36' cy='278' r='3.5' fill='rgba(255,255,255,.55)'/><text x='36' y='308' font-size='11' font-weight='600' text-anchor='middle' fill='rgba(255,255,255,.62)'>Edge</text><rect x='26' y='348' width='20' height='16' rx='3' fill='none' stroke='rgba(255,255,255,.55)' stroke-width='2'/><line x1='26' y1='360' x2='46' y2='360' stroke='rgba(255,255,255,.55)' stroke-width='2'/><text x='36' y='384' font-size='11' font-weight='600' text-anchor='middle' fill='rgba(255,255,255,.62)'>Desk</text><rect x='8' y='406' width='56' height='64' rx='14' fill='#4ED15A'/><line x1='26' y1='424' x2='46' y2='424' stroke='#0F1712' stroke-width='2'/><line x1='26' y1='430' x2='46' y2='430' stroke='#0F1712' stroke-width='2'/><line x1='26' y1='436' x2='40' y2='436' stroke='#0F1712' stroke-width='2'/><text x='36' y='460' font-size='11' font-weight='800' text-anchor='middle' fill='#0F1712'>Ledger</text>"
                & "<circle cx='36' cy='1026' r='5' fill='#F2B33D'/>"
                & "<text x='36' y='1052' font-size='10' font-weight='800' letter-spacing='1.5' text-anchor='middle' fill='#F2B33D'>PAPER</text>"
                & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Header The Ledger] =
        VAR _chip = FORMAT ( [First Trade Date], "d mmm", "en-US" ) & " – " & FORMAT ( [Last Trade Date], "d mmm yyyy", "en-US" )
        VAR _cw = 28 + LEN ( _chip ) * 8.2
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1792 96' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif'>"
                & "<text x='0' y='48' font-family='Georgia,Cambria,Times New Roman,serif' font-size='42' font-weight='700' letter-spacing='-.5' fill='#0F1712'>The Ledger</text>"
                & "<text x='2' y='80' font-size='15' fill='#5E685F'>" & "Every strategy, grouped by asset class · sorted by net P&amp;L · status = Edge / Watch / Cut" & "</text>"
                & "<rect x='" & FORMAT ( 1792 - _cw - 186, "0", "en-US" ) & "' y='26' width='174' height='42' rx='21' fill='#FFFFFF' stroke='#E3E8E3'/>"
                & "<circle cx='" & FORMAT ( 1792 - _cw - 164, "0", "en-US" ) & "' cy='47' r='5' fill='#F2B33D'/>"
                & "<text x='" & FORMAT ( 1792 - _cw - 150, "0", "en-US" ) & "' y='52' font-size='14' font-weight='700' fill='#0F1712'>Alpaca · Paper</text>"
                & "<rect x='" & FORMAT ( 1792 - _cw, "0", "en-US" ) & "' y='26' width='" & FORMAT ( _cw, "0", "en-US" ) & "' height='42' rx='21' fill='#0F1712'/>"
                & "<text x='" & FORMAT ( 1792 - _cw / 2, "0", "en-US" ) & "' y='52' font-size='14' font-weight='700' text-anchor='middle' fill='#FFFFFF'>" & _chip & "</text>"
                & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[Strategy Status] =
        -- Edge = profit factor >= 1.2 on 10+ trades · Cut = losing more than $500 with PF < 0.8 · otherwise Watch
        SWITCH ( TRUE (),
            [Profit Factor] >= 1.2 && [Trades] >= 10, "Edge",
            [Net P&L] < -500 && [Profit Factor] < 0.8, "Cut",
            "Watch" )

    MEASURE gold_fact_trades[HTML - Ledger] =
        -- explore page: one row per strategy inside its asset class, heat bar on net P&L, status pill
        VAR _maxAbs = MAXX ( ALLSELECTED ( gold_fact_trades[strategy] ), ABS ( [Net P&L] ) )
        VAR _th = "<th style='font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#5E685F;text-align:right;padding:10px 12px;border-bottom:2px solid #0F1712'>"
        VAR _classes = ADDCOLUMNS ( VALUES ( gold_fact_trades[asset_class] ), "@v", [Net P&L] )
        VAR _body = CONCATENATEX ( _classes,
            VAR _cls = gold_fact_trades[asset_class]
            VAR _nice = SWITCH ( _cls, "crypto", "Crypto", "us_equity", "Equity", "us_option", "Options", _cls )
            VAR _rows = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( gold_fact_trades[strategy] ), gold_fact_trades[asset_class] = _cls ),
                "@v", CALCULATE ( [Net P&L], gold_fact_trades[asset_class] = _cls ),
                "@n", CALCULATE ( [Trades], gold_fact_trades[asset_class] = _cls ),
                "@w", CALCULATE ( [Win Rate], gold_fact_trades[asset_class] = _cls ),
                "@r", CALCULATE ( [Avg R], gold_fact_trades[asset_class] = _cls ),
                "@pf", CALCULATE ( [Profit Factor], gold_fact_trades[asset_class] = _cls ),
                "@s", CALCULATE ( [Strategy Status], gold_fact_trades[asset_class] = _cls ) )
            RETURN
                "<tr style='background:#EEF2EE'><td colspan='7' style='padding:12px;font-family:Georgia,Cambria,Times New Roman,serif;font-size:19px;font-weight:700'>" & _nice
                    & "<span style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;font-size:13px;font-weight:600;color:#5E685F;margin-left:12px'>" & FORMAT ( CALCULATE ( [Trades] ), "#,0" ) & " trades · "
                    & "<b style='color:" & IF ( [@v] < 0, "#C9402F", "#23803A" ) & "'>" & IF ( [@v] < 0, "▼ ", "▲ " ) & FORMAT ( [@v], "+$#,0;-$#,0", "en-US" ) & "</b></span></td></tr>"
                & CONCATENATEX ( _rows,
                    VAR _c = IF ( [@v] < 0, "#C9402F", "#23803A" )
                    VAR _pill = SWITCH ( [@s], "Edge", "background:#E3F5E5;color:#23803A", "Cut", "background:#FBE3E0;color:#C9402F", "background:#FFF3DA;color:#8A5A00" )
                    RETURN "<tr>"
                        & "<td style='padding:7px 12px;border-bottom:1px solid #E3E8E3;font-family:Cascadia Mono,Consolas,Menlo,monospace;font-size:14px'>" & gold_fact_trades[strategy] & "</td>"
                        & "<td style='padding:7px 12px;border-bottom:1px solid #E3E8E3;text-align:right'>" & FORMAT ( [@n], "#,0" ) & "</td>"
                        & "<td style='padding:7px 12px;border-bottom:1px solid #E3E8E3;text-align:right;white-space:nowrap'><span style='display:inline-block;vertical-align:middle;width:140px;height:10px;margin-right:12px;background:#E3E8E3;border-radius:5px;position:relative'>"
                            & "<span style='position:absolute;top:0;bottom:0;right:0;border-radius:5px;background:" & _c & ";opacity:" & FORMAT ( 0.35 + 0.65 * DIVIDE ( ABS ( [@v] ), _maxAbs ), "0.00", "en-US" ) & ";width:" & FORMAT ( 100 * DIVIDE ( ABS ( [@v] ), _maxAbs ), "0", "en-US" ) & "%'></span></span>"
                            & "<b style='color:" & _c & "'>" & FORMAT ( [@v], "+$#,0;-$#,0", "en-US" ) & "</b></td>"
                        & "<td style='padding:7px 12px;border-bottom:1px solid #E3E8E3;text-align:right;color:" & IF ( [@w] >= 0.5, "#23803A", "#0F1712" ) & "'>" & FORMAT ( [@w], "0%" ) & "</td>"
                        & "<td style='padding:7px 12px;border-bottom:1px solid #E3E8E3;text-align:right'>" & IF ( ISBLANK ( [@r] ), "–", FORMAT ( [@r], "+0.00;-0.00", "en-US" ) & "R" ) & "</td>"
                        & "<td style='padding:7px 12px;border-bottom:1px solid #E3E8E3;text-align:right'>" & IF ( ISBLANK ( [@pf] ), "–", FORMAT ( [@pf], "0.00", "en-US" ) ) & "</td>"
                        & "<td style='padding:7px 12px;border-bottom:1px solid #E3E8E3;text-align:center'><span style='" & _pill & ";border-radius:11px;padding:3px 12px;font-size:12px;font-weight:800;letter-spacing:.04em'>" & UPPER ( [@s] ) & "</span></td>"
                        & "</tr>",
                    "", [@v], DESC ),
            "", [@v], DESC )
        RETURN
            "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;font-variant-numeric:tabular-nums;background:#fff;border:1px solid #E3E8E3;border-radius:20px;height:900px;box-sizing:border-box;padding:20px 28px;overflow:auto;color:#0F1712;font-size:14px'>"
                & "<div style='display:flex;justify-content:space-between;align-items:baseline'><div style='font-family:Georgia,Cambria,Times New Roman,serif;font-size:23px;font-weight:700'>Strategy ledger</div>"
                & "<div style='font-size:13px;color:#5E685F'><b style='color:#23803A'>EDGE</b> PF ≥ 1.2 on 10+ trades · <b style='color:#8A5A00'>WATCH</b> everything else · <b style='color:#C9402F'>CUT</b> &lt; −$500 and PF &lt; 0.8</div></div>"
                & "<table style='width:100%;border-collapse:collapse;margin-top:12px'><tr>"
                & "<th style='font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#5E685F;text-align:left;padding:10px 12px;border-bottom:2px solid #0F1712'>Strategy</th>"
                & _th & "Trades</th>" & _th & "Net P&amp;L</th>" & _th & "Win</th>" & _th & "Avg R</th>" & _th & "PF</th>"
                & "<th style='font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#5E685F;text-align:center;padding:10px 12px;border-bottom:2px solid #0F1712'>Status</th></tr>"
                & _body & "</table></div>" 

    MEASURE gold_fact_trades[Alt - Account Equity] =
        "Account equity is " & FORMAT ( [Account Equity], "$#,0", "en-US" ) & ", " & FORMAT ( [Day P&L], "+$#,0;-$#,0", "en-US" ) & " today."

    MEASURE gold_fact_trades[Alt - Net Closed P&L] =
        "Net closed P&L is " & FORMAT ( [Net P&L], "+$#,0;-$#,0", "en-US" ) & " across " & FORMAT ( [Trades], "#,0" ) & " trades."

    MEASURE gold_fact_trades[Alt - Win Rate] =
        "Win rate is " & FORMAT ( [Win Rate], "0.0%" ) & ": " & [Wins] & " won and " & [Losses] & " lost."

    MEASURE gold_fact_trades[Alt - Profit Factor] =
        "Profit factor is " & FORMAT ( [Profit Factor], "0.00", "en-US" ) & "; break-even is 1.00. Crypto alone is " & FORMAT ( [Crypto Profit Factor], "0.00", "en-US" ) & "."

    MEASURE gold_fact_trades[Alt - Equity Curve] =
        "Line chart of cumulative closed P&L by day, ending at " & FORMAT ( [Net P&L], "$#,0;-$#,0", "en-US" ) & ", peak " & FORMAT ( [Peak P&L], "$#,0;-$#,0", "en-US" ) & ", low " & FORMAT ( [Low P&L], "$#,0;-$#,0", "en-US" ) & ", maximum drawdown " & FORMAT ( [Max Drawdown], "$#,0;-$#,0", "en-US" ) & "."

    MEASURE gold_fact_trades[Alt - Waterfall] =
        "Waterfall: gross wins " & FORMAT ( [Gross Wins], "$#,0", "en-US" ) & ", stop exits " & FORMAT ( [Stop Exit P&L], "$#,0;-$#,0", "en-US" ) & ", other losses " & FORMAT ( [Other Losses], "$#,0;-$#,0", "en-US" ) & ", net " & FORMAT ( [Net P&L], "$#,0;-$#,0", "en-US" ) & "."

    MEASURE gold_fact_trades[Alt - Asset Classes] =
        "Net P&L by asset class: crypto " & FORMAT ( [Crypto P&L], "+$#,0;-$#,0", "en-US" ) & ", equity " & FORMAT ( [Equity P&L], "+$#,0;-$#,0", "en-US" ) & ", options " & FORMAT ( [Options P&L], "+$#,0;-$#,0", "en-US" ) & "."

    MEASURE gold_fact_trades[Alt - Shorts vs Longs] =
        "Shorts " & FORMAT ( [Short P&L], "+$#,0;-$#,0", "en-US" ) & " on " & [Short Trades] & " trades, " & FORMAT ( [Short Win Rate], "0%" ) & " win; longs " & FORMAT ( [Long P&L], "+$#,0;-$#,0", "en-US" ) & " on " & [Long Trades] & " trades, " & FORMAT ( [Long Win Rate], "0%" ) & " win."

    MEASURE gold_fact_trades[Alt - Cover] =
        "Cover: The Book of a Paper Trader. Account equity " & FORMAT ( [Account Equity], "$#,0", "en-US" ) & ", net closed P&L " & FORMAT ( [Net P&L], "+$#,0;-$#,0", "en-US" ) & ", profit factor " & FORMAT ( [Profit Factor], "0.00", "en-US" ) & "."

    MEASURE gold_fact_trades[Alt - Ledger] =
        "Table of " & FORMAT ( [Strategies], "0" ) & " strategies grouped by asset class with trades, net P&L, win rate, average R, profit factor and status."


EVALUATE
    ROW ( "Net P&L", [Net P&L], "Trades", [Trades], "Win Rate", [Win Rate] )
