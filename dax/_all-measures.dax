// Trading Analytics · all measures

// Paste into Power BI Desktop → DAX query view → Run → 'Update model with changes'

// Home table: gold_fact_trades. Display folders follow the dax/ sub-folders.

DEFINE

    MEASURE gold_fact_trades[Trades] =
        COUNTROWS ( gold_fact_trades )

    MEASURE gold_fact_trades[Net P&L] =
        SUM ( gold_fact_trades[net] )

    MEASURE gold_fact_trades[Gross Wins] =
        CALCULATE ( [Net P&L], KEEPFILTERS ( gold_fact_trades[net] > 0 ) )

    MEASURE gold_fact_trades[Gross Losses] =
        CALCULATE ( [Net P&L], KEEPFILTERS ( gold_fact_trades[net] < 0 ) )

    MEASURE gold_fact_trades[Wins] =
        CALCULATE ( [Trades], KEEPFILTERS ( gold_fact_trades[is_win] = TRUE () ) )

    MEASURE gold_fact_trades[Losses] =
        [Trades] - [Wins]

    MEASURE gold_fact_trades[Win Rate] =
        DIVIDE ( [Wins], [Trades] )

    MEASURE gold_fact_trades[Profit Factor] =
        DIVIDE ( [Gross Wins], ABS ( [Gross Losses] ) )

    MEASURE gold_fact_trades[Expectancy] =
        DIVIDE ( [Net P&L], [Trades] )

    MEASURE gold_fact_trades[Avg R] =
        AVERAGE ( gold_fact_trades[r] )

    MEASURE gold_fact_trades[Trades with R] =
        COUNT ( gold_fact_trades[r] )

    MEASURE gold_fact_trades[Cumulative P&L] =
        VAR _d = MAX ( gold_dim_date[Date] )
        RETURN
            CALCULATE (
                [Net P&L],
                FILTER ( ALLSELECTED ( gold_dim_date[Date] ), gold_dim_date[Date] <= _d )
            )

    MEASURE gold_fact_trades[Peak Cumulative P&L] =
        -- running high-water mark; the account starts at 0 so the peak never goes below 0
        VAR _d = MAX ( gold_dim_date[Date] )
        VAR _peak =
            MAXX (
                FILTER ( ALLSELECTED ( gold_dim_date[Date] ), gold_dim_date[Date] <= _d ),
                [Cumulative P&L]
            )
        RETURN MAX ( _peak, 0 )

    MEASURE gold_fact_trades[Drawdown] =
        [Cumulative P&L] - [Peak Cumulative P&L]

    MEASURE gold_fact_trades[Max Drawdown] =
        MINX (
            FILTER ( ALLSELECTED ( gold_dim_date[Date] ), NOT ISBLANK ( [Net P&L] ) ),
            [Drawdown]
        )

    MEASURE gold_fact_trades[Peak P&L] =
        MAXX ( FILTER ( ALLSELECTED ( gold_dim_date[Date] ), NOT ISBLANK ( [Net P&L] ) ), [Cumulative P&L] )

    MEASURE gold_fact_trades[Low P&L] =
        MINX ( FILTER ( ALLSELECTED ( gold_dim_date[Date] ), NOT ISBLANK ( [Net P&L] ) ), [Cumulative P&L] )

    MEASURE gold_fact_trades[First Trade Date] =
        CALCULATE ( MIN ( gold_fact_trades[Date] ), ALLSELECTED ( gold_dim_date ) )

    MEASURE gold_fact_trades[Last Trade Date] =
        CALCULATE ( MAX ( gold_fact_trades[Date] ), ALLSELECTED ( gold_dim_date ) )

    MEASURE gold_fact_trades[Account Equity] =
        VAR _d = MAX ( gold_fact_account[Date] )
        RETURN CALCULATE ( SUM ( gold_fact_account[equity] ), gold_fact_account[Date] = _d, REMOVEFILTERS ( gold_dim_date ) )

    MEASURE gold_fact_trades[Day P&L] =
        VAR _d = MAX ( gold_fact_account[Date] )
        RETURN CALCULATE ( SUM ( gold_fact_account[day_pnl] ), gold_fact_account[Date] = _d, REMOVEFILTERS ( gold_dim_date ) )

    MEASURE gold_fact_trades[Stop Exit P&L] =
        CALCULATE ( [Net P&L], KEEPFILTERS ( gold_fact_trades[exit_type] = "stop" ) )  -- DAX text compare is case-insensitive: Stop + stop

    MEASURE gold_fact_trades[Other Losses] =
        [Gross Losses] - [Stop Exit P&L]

    MEASURE gold_fact_trades[Stop Share of Gains] =
        DIVIDE ( - [Stop Exit P&L], [Gross Wins] )

    MEASURE gold_fact_trades[Crypto P&L] =
        CALCULATE ( [Net P&L], KEEPFILTERS ( gold_fact_trades[asset_class] = "crypto" ) )

    MEASURE gold_fact_trades[Equity P&L] =
        CALCULATE ( [Net P&L], KEEPFILTERS ( gold_fact_trades[asset_class] = "us_equity" ) )

    MEASURE gold_fact_trades[Options P&L] =
        CALCULATE ( [Net P&L], KEEPFILTERS ( gold_fact_trades[asset_class] = "us_option" ) )

    MEASURE gold_fact_trades[Crypto Trades] =
        CALCULATE ( [Trades], KEEPFILTERS ( gold_fact_trades[asset_class] = "crypto" ) )

    MEASURE gold_fact_trades[Crypto Win Rate] =
        CALCULATE ( [Win Rate], KEEPFILTERS ( gold_fact_trades[asset_class] = "crypto" ) )

    MEASURE gold_fact_trades[Crypto Profit Factor] =
        CALCULATE ( [Profit Factor], KEEPFILTERS ( gold_fact_trades[asset_class] = "crypto" ) )

    MEASURE gold_fact_trades[September P&L] =
        CALCULATE ( [Net P&L], KEEPFILTERS ( gold_dim_date[Month] = 9 ) )

    MEASURE gold_fact_trades[October P&L] =
        CALCULATE ( [Net P&L], KEEPFILTERS ( gold_dim_date[Month] = 10 ) )

    MEASURE gold_fact_trades[Title - The Book] =
        -- conclusion title (style guide: the title states the finding)
        VAR _net = [Net P&L]
        RETURN
            "From " & FORMAT ( [Gross Wins] / 1000, "$0.0", "en-US" ) & "K" & " won to "
                & FORMAT ( ABS ( _net ) / 1000, "$0.0", "en-US" ) & "K" & IF ( _net < 0, " lost", " kept" )

    MEASURE gold_fact_trades[Subtitle - The Book] =
        "Is the account growing? · " & FORMAT ( [Trades], "#,0" ) & " closed trades · "
            & FORMAT ( [First Trade Date], "d mmm", "en-US" ) & " – " & FORMAT ( [Last Trade Date], "d mmm yyyy", "en-US" )

    MEASURE gold_fact_trades[Lost Past -1R P&L] =
        CALCULATE ( [Net P&L], KEEPFILTERS ( gold_fact_trades[r] < -1 ) )

    MEASURE gold_fact_trades[Lost Past -1R Trades] =
        CALCULATE ( [Trades], KEEPFILTERS ( gold_fact_trades[r] < -1 ) )

    MEASURE gold_fact_trades[Won 1R+ P&L] =
        CALCULATE ( [Net P&L], KEEPFILTERS ( gold_fact_trades[r] >= 1 ) )

    MEASURE gold_fact_trades[Won 1R+ Trades] =
        CALCULATE ( [Trades], KEEPFILTERS ( gold_fact_trades[r] >= 1 ) )

    MEASURE gold_fact_trades[Stop Exits] =
        CALCULATE ( [Trades], KEEPFILTERS ( gold_fact_trades[exit_type] = "stop" ) )

    MEASURE gold_fact_trades[Stop Exit Recovery %] =
        COALESCE ( CALCULATE ( [Win Rate], KEEPFILTERS ( gold_fact_trades[exit_type] = "stop" ) ), 0 )  -- no winning stop exits -> 0%, not blank

    MEASURE gold_fact_trades[Trailing P&L] =
        CALCULATE ( [Net P&L], KEEPFILTERS ( gold_fact_trades[exit_type] IN { "trailing", "trailing_stop" } ) )

    MEASURE gold_fact_trades[Trailing Win Rate] =
        CALCULATE ( [Win Rate], KEEPFILTERS ( gold_fact_trades[exit_type] IN { "trailing", "trailing_stop" } ) )

    MEASURE gold_fact_trades[Market Exit P&L] =
        CALCULATE ( [Net P&L], KEEPFILTERS ( gold_fact_trades[exit_type] = "market" ) )

    MEASURE gold_fact_trades[Manual Exit P&L] =
        CALCULATE ( [Net P&L], KEEPFILTERS ( gold_fact_trades[exit_type] IN { "manual", "manual_app" } ) )

    MEASURE gold_fact_trades[Take Profit P&L] =
        CALCULATE ( [Net P&L], KEEPFILTERS ( gold_fact_trades[exit_type] = "take_profit" ) )

    MEASURE gold_fact_trades[Take Profit Trades] =
        CALCULATE ( [Trades], KEEPFILTERS ( gold_fact_trades[exit_type] = "take_profit" ) )

    MEASURE gold_fact_trades[Take Profit Avg R] =
        CALCULATE ( [Avg R], KEEPFILTERS ( gold_fact_trades[exit_type] = "take_profit" ) )

    MEASURE gold_fact_trades[Short P&L] =
        CALCULATE ( [Net P&L], KEEPFILTERS ( gold_fact_trades[side] = "short" ) )

    MEASURE gold_fact_trades[Long P&L] =
        CALCULATE ( [Net P&L], KEEPFILTERS ( gold_fact_trades[side] = "long" ) )

    MEASURE gold_fact_trades[Short Trades] =
        CALCULATE ( [Trades], KEEPFILTERS ( gold_fact_trades[side] = "short" ) )

    MEASURE gold_fact_trades[Long Trades] =
        CALCULATE ( [Trades], KEEPFILTERS ( gold_fact_trades[side] = "long" ) )

    MEASURE gold_fact_trades[Short Win Rate] =
        CALCULATE ( [Win Rate], KEEPFILTERS ( gold_fact_trades[side] = "short" ) )

    MEASURE gold_fact_trades[Long Win Rate] =
        CALCULATE ( [Win Rate], KEEPFILTERS ( gold_fact_trades[side] = "long" ) )

    MEASURE gold_fact_trades[Long Share of Trades] =
        DIVIDE ( [Long Trades], [Trades] )

    MEASURE gold_fact_trades[Strategy Rank Best] =
        -- 1 = best strategy by net P&L within the current selection
        IF (
            ISINSCOPE ( gold_fact_trades[strategy] ),
            RANKX ( ALLSELECTED ( gold_fact_trades[strategy] ), [Net P&L], , DESC, DENSE )
        )

    MEASURE gold_fact_trades[Strategy Rank Worst] =
        IF (
            ISINSCOPE ( gold_fact_trades[strategy] ),
            RANKX ( ALLSELECTED ( gold_fact_trades[strategy] ), [Net P&L], , ASC, DENSE )
        )

    MEASURE gold_fact_trades[Strategy Top-Bottom 4 Filter] =
        -- visual-level filter: is 1 for the 4 best and 4 worst strategies
        IF ( [Strategy Rank Best] <= 4 || [Strategy Rank Worst] <= 4, 1, 0 )

    MEASURE gold_fact_trades[Strategies] =
        DISTINCTCOUNT ( gold_fact_trades[strategy] )

    MEASURE gold_fact_trades[Title - The Edge] =
        "Expectancy " & FORMAT ( [Expectancy], "$#,0.00;-$#,0.00", "en-US" ) & " per trade · "
            & IF ( [Short P&L] > [Long P&L], "shorts carry the book", "longs carry the book" )

    MEASURE gold_fact_trades[Cash] =
        VAR _d = MAX ( gold_fact_account[Date] )
        RETURN CALCULATE ( SUM ( gold_fact_account[cash] ), gold_fact_account[Date] = _d, REMOVEFILTERS ( gold_dim_date ) )

    MEASURE gold_fact_trades[Buying Power] =
        VAR _d = MAX ( gold_fact_account[Date] )
        RETURN CALCULATE ( SUM ( gold_fact_account[buying_power] ), gold_fact_account[Date] = _d, REMOVEFILTERS ( gold_dim_date ) )

    MEASURE gold_fact_trades[Long Market Value] =
        VAR _d = MAX ( gold_fact_account[Date] )
        RETURN CALCULATE ( SUM ( gold_fact_account[long_market_value] ), gold_fact_account[Date] = _d, REMOVEFILTERS ( gold_dim_date ) )

    MEASURE gold_fact_trades[Buying Power x Equity] =
        DIVIDE ( [Buying Power], [Account Equity] )

    MEASURE gold_fact_trades[Position Market Value] =
        SUM ( gold_fact_positions[market_value] )

    MEASURE gold_fact_trades[Capital Deployed %] =
        DIVIDE ( [Position Market Value], [Account Equity] )

    MEASURE gold_fact_trades[Cash %] =
        DIVIDE ( [Cash], [Account Equity] )

    MEASURE gold_fact_trades[Unrealized P&L] =
        SUM ( gold_fact_positions[unrealized_pl] )

    MEASURE gold_fact_trades[Unrealized %] =
        DIVIDE ( [Unrealized P&L], SUM ( gold_fact_positions[cost_basis] ) )

    MEASURE gold_fact_trades[Open Positions] =
        COUNTROWS ( gold_fact_positions )

    MEASURE gold_fact_trades[Positions Up] =
        CALCULATE ( [Open Positions], KEEPFILTERS ( gold_fact_positions[unrealized_pl] > 0 ) )

    MEASURE gold_fact_trades[Positions Down] =
        CALCULATE ( [Open Positions], KEEPFILTERS ( gold_fact_positions[unrealized_pl] < 0 ) )

    MEASURE gold_fact_trades[Position Return %] =
        DIVIDE ( [Unrealized P&L], SUM ( gold_fact_positions[cost_basis] ) )

    MEASURE gold_fact_trades[Top Position Symbol] =
        MAXX ( TOPN ( 1, VALUES ( gold_fact_positions[symbol] ), [Position Market Value], DESC ), gold_fact_positions[symbol] )

    MEASURE gold_fact_trades[Top Position Share] =
        DIVIDE (
            MAXX ( VALUES ( gold_fact_positions[symbol] ), [Position Market Value] ),
            [Position Market Value]
        )

    MEASURE gold_fact_trades[Top Position Unrealized] =
        VAR _s = [Top Position Symbol]
        RETURN CALCULATE ( [Unrealized P&L], gold_fact_positions[symbol] = _s )

    MEASURE gold_fact_trades[Orders] =
        COUNTROWS ( gold_fact_orders )

    MEASURE gold_fact_trades[Filled Orders] =
        CALCULATE ( [Orders], KEEPFILTERS ( gold_fact_orders[status] = "filled" ) )

    MEASURE gold_fact_trades[Canceled Orders] =
        CALCULATE ( [Orders], KEEPFILTERS ( gold_fact_orders[status] = "canceled" ) )

    MEASURE gold_fact_trades[Expired Orders] =
        CALCULATE ( [Orders], KEEPFILTERS ( gold_fact_orders[status] = "expired" ) )

    MEASURE gold_fact_trades[Working Orders] =
        [Orders] - [Filled Orders] - [Canceled Orders] - [Expired Orders]

    MEASURE gold_fact_trades[Canceled Sells] =
        CALCULATE ( [Canceled Orders], KEEPFILTERS ( gold_fact_orders[side] = "sell" ) )

    MEASURE gold_fact_trades[Fill Rate] =
        DIVIDE ( [Filled Orders], [Orders] )

    MEASURE gold_fact_trades[Cancel Rate] =
        DIVIDE ( [Canceled Orders], [Orders] )

    MEASURE gold_fact_trades[Turnover] =
        CALCULATE ( SUM ( gold_fact_orders[notional] ), KEEPFILTERS ( gold_fact_orders[status] = "filled" ) )

    MEASURE gold_fact_trades[Turnover x Equity] =
        DIVIDE ( [Turnover], [Account Equity] )

    MEASURE gold_fact_trades[Equities Priced] =
        CALCULATE ( DISTINCTCOUNT ( gold_fact_prices_daily[symbol] ), KEEPFILTERS ( gold_fact_prices_daily[asset_class] = "equity" ) )

    MEASURE gold_fact_trades[Crypto Priced] =
        CALCULATE ( DISTINCTCOUNT ( gold_fact_prices_daily[symbol] ), KEEPFILTERS ( gold_fact_prices_daily[asset_class] = "crypto" ) )

    MEASURE gold_fact_trades[Equities Tracked] =
        [Equities Priced]  -- every tracked equity currently has daily bars

    MEASURE gold_fact_trades[Crypto Pairs Tracked] =
        30  -- universe size from the bot config; 14 pairs are not listed on Alpaca

    MEASURE gold_fact_trades[Title - The Desk] =
        FORMAT ( [Cash] / 1000, "$0.0", "en-US" ) & "K" & " sitting in cash · "
            & FORMAT ( [Capital Deployed %], "0%" ) & " of equity deployed" 

    MEASURE gold_fact_trades[Card - Account Equity HTML] =
        VAR _val = FORMAT ( [Account Equity], "$#,0", "en-US" )
        VAR _sub = "<span style='background:" & IF ( [Day P&L] < 0, "#C9402F", "#23803A" ) & ";color:#fff;border-radius:8px;padding:2px 7px;font-weight:700'>" & FORMAT ( [Day P&L], "+$#,0;-$#,0", "en-US" ) & "</span> today"
        VAR _color = "#FFFFFF"
        RETURN
            "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:20px;padding:20px 24px;height:156px;box-sizing:border-box;position:relative;overflow:hidden;font-variant-numeric:tabular-nums;background:#0F1712;color:#FFFFFF'>"
                & "<div style='font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:rgba(255,255,255,.66)'>Account equity</div>"
                & "<div style='font-size:44px;font-weight:800;letter-spacing:-.025em;line-height:1;margin-top:18px;color:" & _color & "'>" & _val & "</div>"
                & "<div style='font-size:13px;color:rgba(255,255,255,.66);margin-top:12px'>" & _sub & "</div>" & "<div style='position:absolute;right:22px;bottom:22px;display:flex;gap:5px;align-items:flex-end;height:48px'>" & "<i style='width:9px;background:#C9402F;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Day P&L] ), MAX ( ABS ( [Day P&L] ), MAX ( ABS ( [Account Equity]/100 ), ABS ( [Account Equity]/200 ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:9px;background:#23803A;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Account Equity]/100 ), MAX ( ABS ( [Day P&L] ), MAX ( ABS ( [Account Equity]/100 ), ABS ( [Account Equity]/200 ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:9px;background:#4ED15A;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Account Equity]/200 ), MAX ( ABS ( [Day P&L] ), MAX ( ABS ( [Account Equity]/100 ), ABS ( [Account Equity]/200 ) ) ) ), "0", "en-US" ) & "px'></i>" & "</div>"
                & "</div>" 

    MEASURE gold_fact_trades[Card - Net Closed P&L HTML] =
        VAR _val = "<span style='font-size:22px;vertical-align:8px;margin-right:6px'>" & IF ( [Net P&L] < 0, "▼", "▲" ) & "</span>" & FORMAT ( [Net P&L], "$#,0;$#,0", "en-US" )
        VAR _sub = "options · equity · crypto (bars)"
        VAR _color = IF ( [Net P&L] < 0, "#C9402F", "#23803A" )
        RETURN
            "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:20px;padding:20px 24px;height:156px;box-sizing:border-box;position:relative;overflow:hidden;font-variant-numeric:tabular-nums;background:#FFFFFF;color:#0F1712;border:1px solid #E3E8E3'>"
                & "<div style='font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#5E685F'>Net closed P&L</div>"
                & "<div style='font-size:44px;font-weight:800;letter-spacing:-.025em;line-height:1;margin-top:18px;color:" & _color & "'>" & _val & "</div>"
                & "<div style='font-size:13px;color:#5E685F;margin-top:12px'>" & _sub & "</div>" & "<div style='position:absolute;right:22px;bottom:22px;display:flex;gap:5px;align-items:flex-end;height:48px'>" & "<i style='width:9px;background:#C9402F;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Options P&L] ), MAX ( ABS ( [Options P&L] ), MAX ( ABS ( [Equity P&L] ), ABS ( [Crypto P&L] ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:9px;background:#23803A;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Equity P&L] ), MAX ( ABS ( [Options P&L] ), MAX ( ABS ( [Equity P&L] ), ABS ( [Crypto P&L] ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:9px;background:#4ED15A;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Crypto P&L] ), MAX ( ABS ( [Options P&L] ), MAX ( ABS ( [Equity P&L] ), ABS ( [Crypto P&L] ) ) ) ), "0", "en-US" ) & "px'></i>" & "</div>"
                & "</div>" 

    MEASURE gold_fact_trades[Card - Win Rate HTML] =
        VAR _val = FORMAT ( [Win Rate], "0.0%", "en-US" )
        VAR _sub = FORMAT ( [Wins], "#,0" ) & " won · " & FORMAT ( [Losses], "#,0" ) & " lost"
        VAR _color = "#0F1712"
        RETURN
            "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:20px;padding:20px 24px;height:156px;box-sizing:border-box;position:relative;overflow:hidden;font-variant-numeric:tabular-nums;background:#FFFFFF;color:#0F1712;border:1px solid #E3E8E3'>"
                & "<div style='font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#5E685F'>Win rate</div>"
                & "<div style='font-size:44px;font-weight:800;letter-spacing:-.025em;line-height:1;margin-top:18px;color:" & _color & "'>" & _val & "</div>"
                & "<div style='font-size:13px;color:#5E685F;margin-top:12px'>" & _sub & "</div>" & "<div style='position:absolute;right:22px;bottom:22px;display:flex;gap:5px;align-items:flex-end;height:48px'>" & "<i style='width:9px;background:#C9402F;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Losses] ), MAX ( ABS ( [Losses] ), MAX ( ABS ( [Wins] ), ABS ( [Wins] ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:9px;background:#23803A;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Wins] ), MAX ( ABS ( [Losses] ), MAX ( ABS ( [Wins] ), ABS ( [Wins] ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:9px;background:#4ED15A;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Wins] ), MAX ( ABS ( [Losses] ), MAX ( ABS ( [Wins] ), ABS ( [Wins] ) ) ) ), "0", "en-US" ) & "px'></i>" & "</div>"
                & "</div>" 

    MEASURE gold_fact_trades[Card - Profit Factor HTML] =
        VAR _val = FORMAT ( [Profit Factor], "0.00", "en-US" )
        VAR _sub = "break-even is 1.00 · only crypto clears it (" & FORMAT ( [Crypto Profit Factor], "0.00", "en-US" ) & ")"
        VAR _color = "#0F1712"
        RETURN
            "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:20px;padding:20px 24px;height:156px;box-sizing:border-box;position:relative;overflow:hidden;font-variant-numeric:tabular-nums;background:#FFFFFF;color:#0F1712;border:1px solid #E3E8E3'>"
                & "<div style='font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#5E685F'>Profit factor</div>"
                & "<div style='font-size:44px;font-weight:800;letter-spacing:-.025em;line-height:1;margin-top:18px;color:" & _color & "'>" & _val & "</div>"
                & "<div style='font-size:13px;color:#5E685F;margin-top:12px'>" & _sub & "</div>" & "<div style='position:absolute;right:22px;bottom:22px;display:flex;gap:5px;align-items:flex-end;height:48px'>" & "<i style='width:9px;background:#C9402F;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Gross Losses] ), MAX ( ABS ( [Gross Losses] ), MAX ( ABS ( [Gross Wins] ), ABS ( [Gross Wins]*[Crypto Profit Factor]/2 ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:9px;background:#23803A;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Gross Wins] ), MAX ( ABS ( [Gross Losses] ), MAX ( ABS ( [Gross Wins] ), ABS ( [Gross Wins]*[Crypto Profit Factor]/2 ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:9px;background:#4ED15A;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Gross Wins]*[Crypto Profit Factor]/2 ), MAX ( ABS ( [Gross Losses] ), MAX ( ABS ( [Gross Wins] ), ABS ( [Gross Wins]*[Crypto Profit Factor]/2 ) ) ) ), "0", "en-US" ) & "px'></i>" & "</div>"
                & "</div>" 

    MEASURE gold_fact_trades[Card - Expectancy HTML] =
        VAR _val = "<span style='font-size:22px;vertical-align:8px;margin-right:6px'>" & IF ( [Expectancy] < 0, "▼", "▲" ) & "</span>" & FORMAT ( [Expectancy], "$#,0.00;$#,0.00", "en-US" )
        VAR _sub = FORMAT ( [Avg R], "+0.00;-0.00", "en-US" ) & "R" & " avg R-multiple"
        VAR _color = "#FFFFFF"
        RETURN
            "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:20px;padding:20px 24px;height:156px;box-sizing:border-box;position:relative;overflow:hidden;font-variant-numeric:tabular-nums;background:#0F1712;color:#FFFFFF'>"
                & "<div style='font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:rgba(255,255,255,.66)'>Expectancy per trade</div>"
                & "<div style='font-size:44px;font-weight:800;letter-spacing:-.025em;line-height:1;margin-top:18px;color:" & _color & "'>" & _val & "</div>"
                & "<div style='font-size:13px;color:rgba(255,255,255,.66);margin-top:12px'>" & _sub & "</div>" & "<div style='position:absolute;right:22px;bottom:22px;display:flex;gap:5px;align-items:flex-end;height:48px'>" & "<i style='width:9px;background:#C9402F;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Gross Losses] ), MAX ( ABS ( [Gross Losses] ), MAX ( ABS ( [Gross Wins] ), ABS ( [Net P&L] ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:9px;background:#23803A;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Gross Wins] ), MAX ( ABS ( [Gross Losses] ), MAX ( ABS ( [Gross Wins] ), ABS ( [Net P&L] ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:9px;background:#4ED15A;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Net P&L] ), MAX ( ABS ( [Gross Losses] ), MAX ( ABS ( [Gross Wins] ), ABS ( [Net P&L] ) ) ) ), "0", "en-US" ) & "px'></i>" & "</div>"
                & "</div>" 

    MEASURE gold_fact_trades[Card - Lost Past -1R HTML] =
        VAR _val = "<span style='font-size:22px;vertical-align:8px;margin-right:6px'>" & IF ( [Lost Past -1R P&L] < 0, "▼", "▲" ) & "</span>" & FORMAT ( [Lost Past -1R P&L] / 1000, "$0.0;$0.0", "en-US" ) & "K"
        VAR _sub = FORMAT ( [Lost Past -1R Trades], "#,0" ) & " trades slipped their stop"
        VAR _color = "#C9402F"
        RETURN
            "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:20px;padding:20px 24px;height:156px;box-sizing:border-box;position:relative;overflow:hidden;font-variant-numeric:tabular-nums;background:#FFFFFF;color:#0F1712;border:1px solid #E3E8E3'>"
                & "<div style='font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#5E685F'>Lost past −1R</div>"
                & "<div style='font-size:44px;font-weight:800;letter-spacing:-.025em;line-height:1;margin-top:18px;color:" & _color & "'>" & _val & "</div>"
                & "<div style='font-size:13px;color:#5E685F;margin-top:12px'>" & _sub & "</div>"
                & "</div>" 

    MEASURE gold_fact_trades[Card - Won 1R+ HTML] =
        VAR _val = "<span style='font-size:22px;vertical-align:8px;margin-right:6px'>" & IF ( [Won 1R+ P&L] < 0, "▼", "▲" ) & "</span>" & FORMAT ( [Won 1R+ P&L] / 1000, "$0.0;$0.0", "en-US" ) & "K"
        VAR _sub = FORMAT ( [Won 1R+ Trades], "#,0" ) & " trades · the real edge"
        VAR _color = "#23803A"
        RETURN
            "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:20px;padding:20px 24px;height:156px;box-sizing:border-box;position:relative;overflow:hidden;font-variant-numeric:tabular-nums;background:#FFFFFF;color:#0F1712;border:1px solid #E3E8E3'>"
                & "<div style='font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#5E685F'>Won 1R or more</div>"
                & "<div style='font-size:44px;font-weight:800;letter-spacing:-.025em;line-height:1;margin-top:18px;color:" & _color & "'>" & _val & "</div>"
                & "<div style='font-size:13px;color:#5E685F;margin-top:12px'>" & _sub & "</div>"
                & "</div>" 

    MEASURE gold_fact_trades[Card - Stop Exits HTML] =
        VAR _val = FORMAT ( [Stop Exits], "#,0" ) & " trades"
        VAR _sub = FORMAT ( [Stop Exit Recovery %], "0%" ) & " recovered · " & FORMAT ( [Stop Exit P&L], "$#,0;-$#,0", "en-US" )
        VAR _color = "#0F1712"
        RETURN
            "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:20px;padding:20px 24px;height:156px;box-sizing:border-box;position:relative;overflow:hidden;font-variant-numeric:tabular-nums;background:#FFFFFF;color:#0F1712;border:1px solid #E3E8E3'>"
                & "<div style='font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#5E685F'>Stop exits</div>"
                & "<div style='font-size:44px;font-weight:800;letter-spacing:-.025em;line-height:1;margin-top:18px;color:" & _color & "'>" & _val & "</div>"
                & "<div style='font-size:13px;color:#5E685F;margin-top:12px'>" & _sub & "</div>"
                & "</div>" 

    MEASURE gold_fact_trades[Card - Capital Deployed HTML] =
        VAR _val = FORMAT ( [Capital Deployed %], "0%" )
        VAR _sub = "<b style='color:#4ED15A'>" & FORMAT ( [Position Market Value] / 1000, "$0.0", "en-US" ) & "K" & "</b> of " & FORMAT ( [Account Equity] / 1000, "$0.0", "en-US" ) & "K" & " equity"
        VAR _color = "#FFFFFF"
        RETURN
            "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:20px;padding:20px 24px;height:156px;box-sizing:border-box;position:relative;overflow:hidden;font-variant-numeric:tabular-nums;background:#0F1712;color:#FFFFFF'>"
                & "<div style='font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:rgba(255,255,255,.66)'>Capital deployed</div>"
                & "<div style='font-size:44px;font-weight:800;letter-spacing:-.025em;line-height:1;margin-top:18px;color:" & _color & "'>" & _val & "</div>"
                & "<div style='font-size:13px;color:rgba(255,255,255,.66);margin-top:12px'>" & _sub & "</div>"
                & "</div>" 

    MEASURE gold_fact_trades[Card - Unrealized P&L HTML] =
        VAR _val = "<span style='font-size:22px;vertical-align:8px;margin-right:6px'>" & IF ( [Unrealized P&L] < 0, "▼", "▲" ) & "</span>" & FORMAT ( [Unrealized P&L], "$#,0;$#,0", "en-US" )
        VAR _sub = FORMAT ( [Unrealized %], "+0.0%;-0.0%", "en-US" ) & " on cost · " & [Positions Up] & " up, " & [Positions Down] & " down"
        VAR _color = IF ( [Unrealized P&L] < 0, "#C9402F", "#23803A" )
        RETURN
            "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:20px;padding:20px 24px;height:156px;box-sizing:border-box;position:relative;overflow:hidden;font-variant-numeric:tabular-nums;background:#FFFFFF;color:#0F1712;border:1px solid #E3E8E3'>"
                & "<div style='font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#5E685F'>Unrealized P&L</div>"
                & "<div style='font-size:44px;font-weight:800;letter-spacing:-.025em;line-height:1;margin-top:18px;color:" & _color & "'>" & _val & "</div>"
                & "<div style='font-size:13px;color:#5E685F;margin-top:12px'>" & _sub & "</div>"
                & "</div>" 

    MEASURE gold_fact_trades[Card - Fill Rate HTML] =
        VAR _val = FORMAT ( [Fill Rate], "0.0%", "en-US" )
        VAR _sub = FORMAT ( [Filled Orders], "#,0" ) & " of " & FORMAT ( [Orders], "#,0" ) & " orders filled"
        VAR _color = "#0F1712"
        RETURN
            "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:20px;padding:20px 24px;height:156px;box-sizing:border-box;position:relative;overflow:hidden;font-variant-numeric:tabular-nums;background:#FFFFFF;color:#0F1712;border:1px solid #E3E8E3'>"
                & "<div style='font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#5E685F'>Fill rate</div>"
                & "<div style='font-size:44px;font-weight:800;letter-spacing:-.025em;line-height:1;margin-top:18px;color:" & _color & "'>" & _val & "</div>"
                & "<div style='font-size:13px;color:#5E685F;margin-top:12px'>" & _sub & "</div>" & "<div style='position:absolute;right:22px;bottom:22px;display:flex;gap:5px;align-items:flex-end;height:48px'>" & "<i style='width:9px;background:#C9402F;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Canceled Orders] ), MAX ( ABS ( [Canceled Orders] ), MAX ( ABS ( [Filled Orders] ), ABS ( [Working Orders] ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:9px;background:#23803A;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Filled Orders] ), MAX ( ABS ( [Canceled Orders] ), MAX ( ABS ( [Filled Orders] ), ABS ( [Working Orders] ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:9px;background:#4ED15A;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Working Orders] ), MAX ( ABS ( [Canceled Orders] ), MAX ( ABS ( [Filled Orders] ), ABS ( [Working Orders] ) ) ) ), "0", "en-US" ) & "px'></i>" & "</div>"
                & "</div>" 

    MEASURE gold_fact_trades[Card - Turnover HTML] =
        VAR _val = FORMAT ( [Turnover] / 1000000, "$0.0", "en-US" ) & "M"
        VAR _sub = FORMAT ( [Turnover x Equity], "0", "en-US" ) & "× equity"
        VAR _color = "#0F1712"
        RETURN
            "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:20px;padding:20px 24px;height:156px;box-sizing:border-box;position:relative;overflow:hidden;font-variant-numeric:tabular-nums;background:#FFFFFF;color:#0F1712;border:1px solid #E3E8E3'>"
                & "<div style='font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#5E685F'>Turnover</div>"
                & "<div style='font-size:44px;font-weight:800;letter-spacing:-.025em;line-height:1;margin-top:18px;color:" & _color & "'>" & _val & "</div>"
                & "<div style='font-size:13px;color:#5E685F;margin-top:12px'>" & _sub & "</div>"
                & "</div>" 

    MEASURE gold_fact_trades[Panel - Max Drawdown HTML] =
        "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:20px;padding:20px 24px;height:322px;box-sizing:border-box;position:relative;overflow:hidden;font-variant-numeric:tabular-nums;background:#E3F5E5;color:#0F1712;padding:26px 28px'>" & "<div style='font-size:56px;font-weight:800;letter-spacing:-.03em;color:#0F1712'>" & FORMAT ( [Max Drawdown], "$#,0;-$#,0", "en-US" ) & "</div>" & "<div style='font-size:13px;font-weight:600;margin-top:2px'>" & "max drawdown from the " & FORMAT ( [First Trade Date], "d mmm", "en-US" ) & " peak" & "</div>" & "<div style='display:flex;gap:12px;align-items:center;margin-top:14px'><span style='width:30px;height:30px;border-radius:15px;background:rgba(46,158,68,.15);display:grid;place-items:center;color:#C9402F'>&#9679;</span><span><b style='font-size:17px'>" & "September " & FORMAT ( [September P&L], "$#,0;-$#,0", "en-US" ) & "</b><br><span style='font-size:12px;color:#5E685F'>" & "the bleed" & "</span></span></div>" & "<div style='display:flex;gap:12px;align-items:center;margin-top:14px'><span style='width:30px;height:30px;border-radius:15px;background:rgba(46,158,68,.15);display:grid;place-items:center;color:#23803A'>&#9679;</span><span><b style='font-size:17px'>" & "October " & FORMAT ( [October P&L], "$#,0;-$#,0", "en-US" ) & "</b><br><span style='font-size:12px;color:#5E685F'>" & "bleeding stopped" & "</span></span></div>" & "</div>"

    MEASURE gold_fact_trades[Panel - Trailing Stops HTML] =
        VAR _max = MAX ( MAX ( [Market Exit P&L], [Trailing P&L] ), MAX ( [Manual Exit P&L], [Take Profit P&L] ) )
        VAR _best = TOPN ( 1, FILTER ( ADDCOLUMNS ( VALUES ( gold_fact_trades[strategy] ), "@n", [Trades], "@w", [Win Rate], "@r", [Avg R] ), [@n] >= 10 ), [@w], DESC, [@n], DESC )
        RETURN
            "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:20px;padding:20px 24px;height:322px;box-sizing:border-box;position:relative;overflow:hidden;font-variant-numeric:tabular-nums;background:#E3F5E5;color:#0F1712;padding:24px 28px'>"
                & "<div style='font-size:48px;font-weight:800;letter-spacing:-.03em;color:#23803A'>" & FORMAT ( [Trailing P&L], "+$#,0;-$#,0", "en-US" ) & "</div>"
                & "<div style='font-size:13px;font-weight:600;margin:2px 0 6px'>from trailing stops · " & FORMAT ( [Trailing Win Rate], "0%" ) & " win</div>"
                & "<div style='display:flex;align-items:center;gap:10px;margin-top:7px;font-size:12px'><span style='width:84px;font-weight:600'>Market</span><span style='flex:1;height:9px;border-radius:5px;background:rgba(15,23,18,.08);position:relative'><span style='position:absolute;left:0;top:0;bottom:0;border-radius:5px;background:#23803A;width:" & FORMAT ( DIVIDE ( MAX ( [Market Exit P&L], 0 ), _max ) * 100, "0", "en-US" ) & "%'></span></span><span style='width:70px;text-align:right;font-weight:700;color:#23803A'>" & FORMAT ( [Market Exit P&L], "+$#,0;-$#,0", "en-US" ) & "</span></div>" & "<div style='display:flex;align-items:center;gap:10px;margin-top:7px;font-size:12px'><span style='width:84px;font-weight:600'>Trailing</span><span style='flex:1;height:9px;border-radius:5px;background:rgba(15,23,18,.08);position:relative'><span style='position:absolute;left:0;top:0;bottom:0;border-radius:5px;background:#23803A;width:" & FORMAT ( DIVIDE ( MAX ( [Trailing P&L], 0 ), _max ) * 100, "0", "en-US" ) & "%'></span></span><span style='width:70px;text-align:right;font-weight:700;color:#23803A'>" & FORMAT ( [Trailing P&L], "+$#,0;-$#,0", "en-US" ) & "</span></div>"
                & "<div style='display:flex;align-items:center;gap:10px;margin-top:7px;font-size:12px'><span style='width:84px;font-weight:600'>Manual</span><span style='flex:1;height:9px;border-radius:5px;background:rgba(15,23,18,.08);position:relative'><span style='position:absolute;left:0;top:0;bottom:0;border-radius:5px;background:#23803A;width:" & FORMAT ( DIVIDE ( MAX ( [Manual Exit P&L], 0 ), _max ) * 100, "0", "en-US" ) & "%'></span></span><span style='width:70px;text-align:right;font-weight:700;color:#23803A'>" & FORMAT ( [Manual Exit P&L], "+$#,0;-$#,0", "en-US" ) & "</span></div>" & "<div style='display:flex;align-items:center;gap:10px;margin-top:7px;font-size:12px'><span style='width:84px;font-weight:600'>Take profit</span><span style='flex:1;height:9px;border-radius:5px;background:rgba(15,23,18,.08);position:relative'><span style='position:absolute;left:0;top:0;bottom:0;border-radius:5px;background:#23803A;width:" & FORMAT ( DIVIDE ( MAX ( [Take Profit P&L], 0 ), _max ) * 100, "0", "en-US" ) & "%'></span></span><span style='width:70px;text-align:right;font-weight:700;color:#23803A'>" & FORMAT ( [Take Profit P&L], "+$#,0;-$#,0", "en-US" ) & "</span></div>"
                & "<div style='display:flex;gap:12px;align-items:center;margin-top:14px'><span style='width:30px;height:30px;border-radius:15px;background:rgba(46,158,68,.15);display:grid;place-items:center;color:#23803A'>&#9679;</span><span><b style='font-size:17px'>" & "Take profit " & FORMAT ( [Take Profit P&L], "+$#,0", "en-US" ) & "</b><br><span style='font-size:12px;color:#5E685F'>" & FORMAT ( [Take Profit Trades], "0" ) & " exits · 100% win · avg " & FORMAT ( [Take Profit Avg R], "0.00", "en-US" ) & "R" & "</span></span></div>"
                & "<div style='display:flex;gap:12px;align-items:center;margin-top:14px'><span style='width:30px;height:30px;border-radius:15px;background:rgba(46,158,68,.15);display:grid;place-items:center;color:#23803A'>&#9679;</span><span><b style='font-size:17px'>" & MAXX ( _best, gold_fact_trades[strategy] ) & " · " & FORMAT ( MAXX ( _best, [@w] ), "0%" ) & " win" & "</b><br><span style='font-size:12px;color:#5E685F'>" & FORMAT ( MAXX ( _best, [@n] ), "0" ) & " trades · " & FORMAT ( MAXX ( _best, [@r] ), "+0.00;-0.00", "en-US" ) & "R avg · most reliable" & "</span></span></div>"
                & "</div>" 

    MEASURE gold_fact_trades[Panel - Cash HTML] =
        VAR _eq = [Account Equity]
        VAR _pos = ADDCOLUMNS ( VALUES ( gold_fact_positions[symbol] ), "@mv", [Position Market Value], "@r", [Position Return %] )
        VAR _strip = CONCATENATEX ( _pos,
            "<span title='" & gold_fact_positions[symbol] & "' style='display:inline-block;height:12px;width:" & FORMAT ( DIVIDE ( [@mv], _eq ) * 100, "0.00", "en-US" ) & "%;background:"
                & IF ( [@r] >= 0.01, "#23803A", IF ( [@r] >= 0, "#A9E5AE", IF ( [@r] > -0.01, "#F2B5AE", "#C9402F" ) ) ) & "'></span>",
            "", [@mv], DESC )
        VAR _names = CONCATENATEX ( _pos, gold_fact_positions[symbol], " · ", [@mv], DESC )
        RETURN
            "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:20px;padding:20px 24px;height:322px;box-sizing:border-box;position:relative;overflow:hidden;font-variant-numeric:tabular-nums;background:#E3F5E5;color:#0F1712;padding:24px 28px'>"
                & "<div style='display:flex;justify-content:space-between;align-items:flex-start'><div>"
                & "<div style='font-size:52px;font-weight:800;letter-spacing:-.03em'>" & FORMAT ( [Cash] / 1000, "$0.0", "en-US" ) & "K</div>"
                & "<div style='font-size:13px;font-weight:600;margin-top:2px'><span style='color:#23803A'>&#9675;</span> sitting in cash · " & FORMAT ( [Cash %], "0%" ) & " of equity</div></div>"
                & "<img style='width:92px;height:92px' src=""" & [SVG - Cash Donut] & """/></div>"
                & "<div style='margin-top:18px;height:12px;border-radius:6px;overflow:hidden;background:#E3E8E3;white-space:nowrap;font-size:0'>" & _strip & "</div>"
                & "<div style='display:flex;justify-content:space-between;font-size:12px;color:#5E685F;margin-top:5px'><span>" & _names & "</span><span>Cash " & FORMAT ( [Cash %], "0%" ) & "</span></div>"
                & "<div style='display:flex;gap:12px;align-items:center;margin-top:14px'><span style='width:30px;height:30px;border-radius:15px;background:rgba(46,158,68,.15);display:grid;place-items:center;color:#23803A'>&#9679;</span><span><b style='font-size:17px'>" & "Buying power " & FORMAT ( [Buying Power], "$#,0", "en-US" ) & "</b><br><span style='font-size:12px;color:#5E685F'>" & FORMAT ( [Buying Power x Equity], "0.0", "en-US" ) & "× equity · margin unused" & "</span></span></div>"
                & "<div style='display:flex;gap:12px;align-items:center;margin-top:14px'><span style='width:30px;height:30px;border-radius:15px;background:rgba(46,158,68,.15);display:grid;place-items:center;color:#23803A'>&#9679;</span><span><b style='font-size:17px'>" & [Top Position Symbol] & " is " & FORMAT ( [Top Position Share], "0%" ) & " of exposure" & "</b><br><span style='font-size:12px;color:#5E685F'>" & FORMAT ( [Top Position Unrealized], "+$#,0;-$#,0", "en-US" ) & " unrealized" & "</span></span></div>"
                & "</div>" 

    MEASURE gold_fact_trades[Panel - Shorts vs Longs HTML] =
        "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:20px;padding:20px 24px;height:322px;box-sizing:border-box;position:relative;overflow:hidden;font-variant-numeric:tabular-nums;background:#0F1712;color:#FFFFFF;padding:26px 28px'>" & "<div style='font-size:15px;font-weight:700;margin-bottom:12px'>" & IF ( [Short P&L] > [Long P&L], "Shorts carry the book", "Longs carry the book" ) & "</div>" & "<div style='display:flex;gap:10px'>" & "<div style='flex:1;background:#1B2A20;border-radius:12px;padding:12px'><div style='font-size:12px;opacity:.6'>Short · " & [Short Trades] & "</div><div style='font-size:26px;font-weight:800;color:#4ED15A'>" & FORMAT ( [Short P&L], "+$#,0;-$#,0", "en-US" ) & "</div><div style='font-size:12px;opacity:.6'>" & FORMAT ( [Short Win Rate], "0%" ) & " win</div></div>" & "<div style='flex:1;background:#1B2A20;border-radius:12px;padding:12px'><div style='font-size:12px;opacity:.6'>Long · " & [Long Trades] & "</div><div style='font-size:26px;font-weight:800;color:#C9402F'>" & FORMAT ( [Long P&L], "+$#,0;-$#,0", "en-US" ) & "</div><div style='font-size:12px;opacity:.6'>" & FORMAT ( [Long Win Rate], "0%" ) & " win</div></div>" & "</div>" & "</div>"

    MEASURE gold_fact_trades[SVG - Equity Curve & Drawdown] =
        -- line = cumulative closed P&L; red band underneath = drawdown from the running peak
        -- y-axis in $K (12px labels), PEAK / LOW chips and start / end values on the line
        VAR _W = 900  VAR _H = 220  VAR _L = 56  VAR _R = 12
        VAR _t = ADDCOLUMNS ( FILTER ( ALLSELECTED ( gold_dim_date[Date] ), NOT ISBLANK ( [Net P&L] ) ), "@cum", [Cumulative P&L], "@dd", [Drawdown] )
        VAR _d0 = MINX ( _t, gold_dim_date[Date] )  VAR _d1 = MAXX ( _t, gold_dim_date[Date] )
        VAR _hi = MAX ( 0, MAXX ( _t, [@cum] ) )  VAR _lo = MIN ( 0, MINX ( _t, [@cum] ) )
        VAR _ddlo = MIN ( -1, MINX ( _t, [@dd] ) )
        VAR _span = MAX ( 1, INT ( _d1 - _d0 ) )
        VAR _pts = ADDCOLUMNS ( _t,
            "@x", _L + INT ( gold_dim_date[Date] - _d0 ) / _span * ( _W - _L - _R ),
            "@y", 14 + ( _hi - [@cum] ) / MAX ( 1, _hi - _lo ) * 118,
            "@uy", 156 + [@dd] / _ddlo * 44 )
        VAR _line = CONCATENATEX ( _pts, FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@y], "0.0", "en-US" ), " ", gold_dim_date[Date], ASC )
        VAR _under = CONCATENATEX ( _pts, FORMAT ( [@x], "0.0", "en-US" ) & "," & FORMAT ( [@uy], "0.0", "en-US" ), " ", gold_dim_date[Date], ASC )
        VAR _y0 = 14 + _hi / MAX ( 1, _hi - _lo ) * 118
        VAR _first = TOPN ( 1, _pts, gold_dim_date[Date], ASC )
        VAR _last = TOPN ( 1, _pts, gold_dim_date[Date], DESC )
        VAR _pk = TOPN ( 1, _pts, [@cum], DESC, gold_dim_date[Date], ASC )
        VAR _lw = TOPN ( 1, _pts, [@cum], ASC, gold_dim_date[Date], ASC )
        VAR _lx = MAXX ( _last, [@x] )  VAR _ly = MAXX ( _last, [@y] )
        VAR _fx = MAXX ( _first, [@x] ) VAR _fy = MAXX ( _first, [@y] )
        VAR _px = MAXX ( _pk, [@x] )    VAR _py = MAXX ( _pk, [@y] )   VAR _pv = MAXX ( _pk, [@cum] )
        VAR _wx = MAXX ( _lw, [@x] )    VAR _wy = MAXX ( _lw, [@y] )   VAR _wv = MAXX ( _lw, [@cum] )
        -- chips stay inside the plot: shift right of the left edge, flip below the point when there is no room above
        VAR _pcx = MIN ( MAX ( _px, 106 ), 842 )  VAR _pcy = IF ( _py - 28 < 0, _py + 9, _py - 28 )
        VAR _wcx = MIN ( MAX ( _wx, 106 ), 842 )
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 900 220' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif' >"
                & "<line x1='56' x2='888' y1='14' y2='14' stroke='#E3E8E3' stroke-dasharray='2 4'/>"
                & "<line x1='56' x2='888' y1='132' y2='132' stroke='#E3E8E3' stroke-dasharray='2 4'/>"
                & "<line x1='56' x2='888' y1='" & FORMAT ( _y0, "0.0", "en-US" ) & "' y2='" & FORMAT ( _y0, "0.0", "en-US" ) & "' stroke='#BFC8C0'/>"
                & "<text x='48' y='18' font-size='12' text-anchor='end' fill='#5E685F'>" & FORMAT ( _hi / 1000, "$0.0K;-$0.0K", "en-US" ) & "</text>"
                & "<text x='48' y='" & FORMAT ( _y0 + 4, "0.0", "en-US" ) & "' font-size='12' text-anchor='end' fill='#5E685F'>$0</text>"
                & "<text x='48' y='136' font-size='12' text-anchor='end' fill='#5E685F'>" & FORMAT ( _lo / 1000, "$0.0K;-$0.0K", "en-US" ) & "</text>"
                & "<polyline points='" & _line & "' fill='none' stroke='#23803A' stroke-width='2.4' stroke-linejoin='round'/>"
                & "<line x1='56' x2='888' y1='156' y2='156' stroke='#E3E8E3'/>"
                & "<text x='48' y='160' font-size='12' text-anchor='end' fill='#5E685F'>DD</text>"
                & "<polygon points='" & FORMAT ( _fx, "0.0", "en-US" ) & ",156 " & _under & " " & FORMAT ( _lx, "0.0", "en-US" ) & ",156' fill='#C9402F' fill-opacity='.18' stroke='#C9402F' stroke-width='1.2'/>"
                & "<circle cx='" & FORMAT ( _fx, "0.0", "en-US" ) & "' cy='" & FORMAT ( _fy, "0.0", "en-US" ) & "' r='3.5' fill='#0F1712'/>"
                & "<rect x='" & FORMAT ( _pcx - 44, "0.0", "en-US" ) & "' y='" & FORMAT ( _pcy, "0.0", "en-US" ) & "' width='88' height='19' rx='9.5' fill='#F2B33D'/>"
                & "<text x='" & FORMAT ( _pcx, "0.0", "en-US" ) & "' y='" & FORMAT ( _pcy + 13.5, "0.0", "en-US" ) & "' font-size='11' font-weight='800' text-anchor='middle' fill='#0F1712'>PEAK " & FORMAT ( _pv / 1000, "$0.0K;-$0.0K", "en-US" ) & "</text>"
                & "<circle cx='" & FORMAT ( _px, "0.0", "en-US" ) & "' cy='" & FORMAT ( _py, "0.0", "en-US" ) & "' r='4.5' fill='#F2B33D' stroke='#fff' stroke-width='1.5'/>"
                & "<rect x='" & FORMAT ( _wcx - 44, "0.0", "en-US" ) & "' y='" & FORMAT ( _wy + 9, "0.0", "en-US" ) & "' width='88' height='19' rx='9.5' fill='#0F1712'/>"
                & "<text x='" & FORMAT ( _wcx, "0.0", "en-US" ) & "' y='" & FORMAT ( _wy + 22.5, "0.0", "en-US" ) & "' font-size='11' font-weight='800' text-anchor='middle' fill='#fff'>LOW " & FORMAT ( _wv / 1000, "$0.0K;-$0.0K", "en-US" ) & "</text>"
                & "<circle cx='" & FORMAT ( _wx, "0.0", "en-US" ) & "' cy='" & FORMAT ( _wy, "0.0", "en-US" ) & "' r='4.5' fill='#0F1712' stroke='#fff' stroke-width='1.5'/>"
                & "<circle cx='" & FORMAT ( _lx, "0.0", "en-US" ) & "' cy='" & FORMAT ( _ly, "0.0", "en-US" ) & "' r='5' fill='#23803A' stroke='#fff' stroke-width='1.5'/>"
                & "<text x='" & FORMAT ( _lx - 10, "0.0", "en-US" ) & "' y='" & FORMAT ( _ly - 12, "0.0", "en-US" ) & "' font-size='13' font-weight='800' text-anchor='end' fill='#0F1712'>Now " & FORMAT ( [Net P&L], "$#,0;-$#,0", "en-US" ) & "</text>"
                & "<text x='" & FORMAT ( _fx, "0.0", "en-US" ) & "' y='216' font-size='12' fill='#5E685F'>" & FORMAT ( _d0, "d mmm", "en-US" ) & "</text>"
                & "<text x='888' y='216' font-size='12' text-anchor='end' fill='#5E685F'>" & FORMAT ( _d1, "d mmm", "en-US" ) & "</text>"
                & "<text x='470' y='216' font-size='12' font-weight='700' text-anchor='middle' fill='#C9402F'>Max drawdown " & FORMAT ( _ddlo, "$#,0;-$#,0", "en-US" ) & "</text>"
                & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - P&L Waterfall] =
        -- gross wins → stop exits → other losses → net (bars start from zero, per the style guide)
        VAR _gw = [Gross Wins]  VAR _st = [Stop Exit P&L]  VAR _ot = [Other Losses]  VAR _net = [Net P&L]
        VAR _min = MIN ( 0, _net )  VAR _max = _gw
        VAR _sc = 600 / ( _max - _min )
        VAR _z = 150 - _min * _sc
        VAR _x1 = _z + _gw * _sc  VAR _x2 = _x1 + _st * _sc  VAR _x3 = _x2 + _ot * _sc
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 900 150' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif' font-size='14'>"
                & "<line x1='" & FORMAT ( _z, "0.0", "en-US" ) & "' x2='" & FORMAT ( _z, "0.0", "en-US" ) & "' y1='0' y2='136' stroke='#BFC8C0'/>"
                & "<text x='0' y='19' fill='#0F1712'>Gross wins</text><rect x='" & FORMAT ( _z, "0.0", "en-US" ) & "' y='4' width='" & FORMAT ( ( _x1 - _z ), "0.0", "en-US" ) & "' height='22' rx='6' fill='#23803A'/>"
                & "<text x='896' y='19' text-anchor='end' font-weight='700' fill='#23803A'>" & FORMAT ( _gw, "+$#,0", "en-US" ) & "</text>"
                & "<text x='0' y='53' fill='#0F1712'>Stop exits</text><rect x='" & FORMAT ( _x2, "0.0", "en-US" ) & "' y='38' width='" & FORMAT ( ( _x1 - _x2 ), "0.0", "en-US" ) & "' height='22' rx='6' fill='#C9402F'/>"
                & "<text x='896' y='53' text-anchor='end' font-weight='700' fill='#C9402F'>" & FORMAT ( _st, "$#,0;-$#,0", "en-US" ) & "</text>"
                & "<text x='0' y='87' fill='#0F1712'>Other losses</text><rect x='" & FORMAT ( _x3, "0.0", "en-US" ) & "' y='72' width='" & FORMAT ( ( _x2 - _x3 ), "0.0", "en-US" ) & "' height='22' rx='6' fill='#F2B5AE'/>"
                & "<text x='896' y='87' text-anchor='end' font-weight='700' fill='#C9402F'>" & FORMAT ( _ot, "$#,0;-$#,0", "en-US" ) & "</text>"
                & "<text x='0' y='121' font-weight='700' fill='#0F1712'>Net P&amp;L</text><rect x='" & FORMAT ( MIN ( _z, _x3 ), "0.0", "en-US" ) & "' y='106' width='" & FORMAT ( ABS ( _z - _x3 ), "0.0", "en-US" ) & "' height='22' rx='6' fill='#0F1712'/>"
                & "<text x='896' y='121' text-anchor='end' font-weight='700' fill='#0F1712'>" & FORMAT ( _net, "$#,0;-$#,0", "en-US" ) & "</text>"
                & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Crypto vs Equity Weekly] =
        -- cumulative P&L by week for crypto (green) and equity (red)
        VAR _wk = FILTER ( ALLSELECTED ( gold_dim_date[WeekStart] ), NOT ISBLANK ( [Net P&L] ) )
        VAR _t = ADDCOLUMNS ( _wk,
            "@c", VAR w = gold_dim_date[WeekStart] RETURN CALCULATE ( [Crypto P&L], FILTER ( ALLSELECTED ( gold_dim_date ), gold_dim_date[WeekStart] <= w ) ),
            "@e", VAR w = gold_dim_date[WeekStart] RETURN CALCULATE ( [Equity P&L], FILTER ( ALLSELECTED ( gold_dim_date ), gold_dim_date[WeekStart] <= w ) ) )
        VAR _n = COUNTROWS ( _t )
        VAR _hi = MAX ( 1, MAX ( MAXX ( _t, [@c] ), MAXX ( _t, [@e] ) ) )
        VAR _lo = MIN ( 0, MIN ( MINX ( _t, [@c] ), MINX ( _t, [@e] ) ) )
        VAR _r = ADDCOLUMNS ( _t, "@i", RANKX ( _t, gold_dim_date[WeekStart], , ASC ) )
        VAR _lc = CONCATENATEX ( _r, FORMAT ( 10 + ( [@i] - 1 ) / MAX ( 1, _n - 1 ) * 700, "0.0", "en-US" ) & "," & FORMAT ( 10 + ( _hi - [@c] ) / ( _hi - _lo ) * 140, "0.0", "en-US" ), " ", [@i], ASC )
        VAR _le = CONCATENATEX ( _r, FORMAT ( 10 + ( [@i] - 1 ) / MAX ( 1, _n - 1 ) * 700, "0.0", "en-US" ) & "," & FORMAT ( 10 + ( _hi - [@e] ) / ( _hi - _lo ) * 140, "0.0", "en-US" ), " ", [@i], ASC )
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 820 160' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif'>"
                & "<polyline points='" & _lc & "' fill='none' stroke='#4ED15A' stroke-width='2.5'/>"
                & "<polyline points='" & _le & "' fill='none' stroke='#C9402F' stroke-width='2.5'/>"
                & "<text x='720' y='20' font-size='13' font-weight='700' fill='#4ED15A'>Crypto " & FORMAT ( [Crypto P&L], "+$#,0;-$#,0", "en-US" ) & "</text>"
                & "<text x='720' y='40' font-size='13' font-weight='700' fill='#C9402F'>Equity " & FORMAT ( [Equity P&L], "+$#,0;-$#,0", "en-US" ) & "</text>"
                & "<text x='720' y='60' font-size='13' font-weight='700' fill='#F2B5AE'>Options " & FORMAT ( [Options P&L], "+$#,0;-$#,0", "en-US" ) & "</text>"
                & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Strategy Lollipop] =
        -- 4 best and 4 worst strategies · columns: name | trades | stem from $0 + value | win-rate chip
        VAR _all = ADDCOLUMNS ( ALLSELECTED ( gold_fact_trades[strategy] ), "@v", [Net P&L], "@n", [Trades], "@w", [Win Rate] )
        VAR _sel = UNION ( TOPN ( 4, _all, [@v], DESC ), TOPN ( 4, _all, [@v], ASC ) )
        VAR _rk = ADDCOLUMNS ( _sel, "@i", RANKX ( _sel, [@v], , DESC, DENSE ) )
        VAR _m = MAX ( MAXX ( _sel, ABS ( [@v] ) ), 1 )
        VAR _maxn = MAXX ( _sel, [@n] )
        VAR _z = 590
        VAR _rows = CONCATENATEX ( _rk,
            VAR y = FORMAT ( 30 + ( [@i] - 1 ) * 24.5, "0.0", "en-US" )
            VAR yt = FORMAT ( 34.5 + ( [@i] - 1 ) * 24.5, "0.0", "en-US" )
            VAR x = _z + [@v] / _m * 180
            VAR c = IF ( [@v] >= 0, "#23803A", "#C9402F" )
            VAR wc = IF ( [@w] >= 0.5, "#23803A", "#C9402F" )
            RETURN
                "<text x='0' y='" & yt & "' font-family='Cascadia Mono,Consolas,Menlo,monospace' font-size='13' fill='#0F1712'>" & gold_fact_trades[strategy] & "</text>"
                & "<text x='300' y='" & yt & "' font-size='12' text-anchor='end' fill='#5E685F'>" & [@n] & "</text>"
                & "<line x1='" & FORMAT ( _z, "0.0", "en-US" ) & "' x2='" & FORMAT ( x, "0.0", "en-US" ) & "' y1='" & y & "' y2='" & y & "' stroke='" & c & "' stroke-width='2'/>"
                & "<circle cx='" & FORMAT ( x, "0.0", "en-US" ) & "' cy='" & y & "' r='" & FORMAT ( 4 + 5 * SQRT ( [@n] / _maxn ), "0.0", "en-US" ) & "' fill='" & c & "' stroke='#fff' stroke-width='1.5'/>"
                & "<text x='" & FORMAT ( x + IF ( [@v] >= 0, 14, -14 ), "0.0", "en-US" ) & "' y='" & yt & "' font-size='13' font-weight='800' fill='" & c & "' text-anchor='" & IF ( [@v] >= 0, "start", "end" ) & "'>" & FORMAT ( [@v], "+$#,0;-$#,0", "en-US" ) & "</text>"
                & "<rect x='846' y='" & FORMAT ( 30 + ( [@i] - 1 ) * 24.5 - 9, "0.0", "en-US" ) & "' width='50' height='18' rx='9' fill='" & wc & "' fill-opacity='.12'/>"
                & "<text x='871' y='" & yt & "' font-size='12' font-weight='700' text-anchor='middle' fill='" & wc & "'>" & FORMAT ( [@w], "0%" ) & "</text>",
            "", [@i], ASC )
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 900 228' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif'>"
                & "<text x='0' y='10' font-size='11' font-weight='700' letter-spacing='1' fill='#5E685F'>STRATEGY</text>"
                & "<text x='300' y='10' font-size='11' font-weight='700' letter-spacing='1' text-anchor='end' fill='#5E685F'>TRADES</text>"
                & "<text x='590' y='10' font-size='11' font-weight='700' letter-spacing='1' text-anchor='middle' fill='#5E685F'>NET P&amp;L</text>"
                & "<text x='871' y='10' font-size='11' font-weight='700' letter-spacing='1' text-anchor='middle' fill='#5E685F'>WIN</text>"
                & "<line x1='" & FORMAT ( _z, "0.0", "en-US" ) & "' x2='" & FORMAT ( _z, "0.0", "en-US" ) & "' y1='18' y2='222' stroke='#BFC8C0'/>"
                & "<line x1='0' x2='900' y1='121.5' y2='121.5' stroke='#E3E8E3' stroke-dasharray='2 4'/>" & _rows & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - R-Multiple Dots] =
        -- every dot is a trade, binned to the nearest 0.5R (clamped to -2.5R … +3R)
        VAR _tr = ADDCOLUMNS (
            FILTER ( ALLSELECTED ( gold_fact_trades ), NOT ISBLANK ( gold_fact_trades[r] ) ),
            "@b", MIN ( 3, MAX ( -2.5, ROUND ( gold_fact_trades[r] * 2, 0 ) / 2 ) ) )
        VAR _bins = SELECTCOLUMNS ( GENERATESERIES ( -5, 6, 1 ), "@bin", [Value] / 2 )
        VAR _cnt = ADDCOLUMNS ( _bins, "@n", VAR b = [@bin] RETURN COUNTROWS ( FILTER ( _tr, [@b] = b ) ) + 0 )
        VAR _cols = CONCATENATEX ( _cnt,
            VAR b = [@bin]  VAR n = [@n]
            VAR cx = 40 + ( b + 2.5 ) * 2 * 72
            VAR c = IF ( b < 0, "#C9402F", IF ( b = 0, "#BFC8C0", "#23803A" ) )
            VAR dots = CONCATENATEX ( GENERATESERIES ( 0, MAX ( 0, n - 1 ), 1 ),
                IF ( n > 0,
                    "<circle cx='" & FORMAT ( cx - 15 + MOD ( [Value], 4 ) * 10, "0", "en-US" ) & "' cy='" & ( 180 - INT ( [Value] / 4 ) * 10 ) & "' r='4' fill='" & c & "'/>" ), "" )
            RETURN dots
                & "<text x='" & cx & "' y='" & ( 168 - INT ( MAX ( n - 1, 0 ) / 4 ) * 10 - 10 ) & "' font-size='12' font-weight='700' text-anchor='middle' fill='#0F1712'>" & n & "</text>"
                & "<text x='" & cx & "' y='202' font-size='12' text-anchor='middle' fill='#5E685F'>" & FORMAT ( b, "+0.0;-0.0;0", "en-US" ) & "R" & "</text>",
            "", [@bin], ASC )
        VAR _svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 900 210' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif'>"
                & "<line x1='0' x2='900' y1='188' y2='188' stroke='#E3E8E3'/>" & _cols & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Long vs Short Units] =
        -- one tick per trade: wins green, losses red, for shorts and longs
        VAR _sw = CALCULATE ( [Wins], KEEPFILTERS ( gold_fact_trades[side] = "short" ) )
        VAR _sl = [Short Trades] - _sw
        VAR _lw = CALCULATE ( [Wins], KEEPFILTERS ( gold_fact_trades[side] = "long" ) )
        VAR _ll = [Long Trades] - _lw
        VAR _u = 3.1
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 900 90' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif' font-size='13'>"
                & "<text x='0' y='22' fill='#fff' font-weight='700'>Short</text>"
                & "<rect x='70' y='10' width='" & FORMAT ( _sw * _u, "0.0", "en-US" ) & "' height='16' fill='#4ED15A'/>"
                & "<rect x='" & FORMAT ( 70 + _sw * _u, "0.0", "en-US" ) & "' y='10' width='" & FORMAT ( _sl * _u, "0.0", "en-US" ) & "' height='16' fill='#C9402F'/>"
                & "<text x='70' y='42' font-size='11' fill='rgba(255,255,255,.6)'>" & _sw & " won · " & _sl & " lost</text>"
                & "<text x='0' y='66' fill='#fff' font-weight='700'>Long</text>"
                & "<rect x='70' y='54' width='" & FORMAT ( _lw * _u, "0.0", "en-US" ) & "' height='16' fill='#4ED15A'/>"
                & "<rect x='" & FORMAT ( 70 + _lw * _u, "0.0", "en-US" ) & "' y='54' width='" & FORMAT ( _ll * _u, "0.0", "en-US" ) & "' height='16' fill='#C9402F'/>"
                & "<text x='70' y='86' font-size='11' fill='rgba(255,255,255,.6)'>" & _lw & " won · " & _ll & " lost</text>"
                & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Positions Treemap] =
        -- strip treemap: width = market value, colour = return on cost
        VAR _p = ADDCOLUMNS ( VALUES ( gold_fact_positions[symbol] ), "@mv", [Position Market Value], "@r", [Position Return %] )
        VAR _tot = SUMX ( _p, [@mv] )
        VAR _rk = ADDCOLUMNS ( _p, "@i", RANKX ( _p, [@mv], , DESC, DENSE ) )
        VAR _x = ADDCOLUMNS ( _rk, "@x0", VAR i = [@i] RETURN SUMX ( FILTER ( _rk, [@i] < i ), [@mv] ) / _tot * 900 )
        VAR _tiles = CONCATENATEX ( _x,
            VAR w = [@mv] / _tot * 900
            VAR c = IF ( [@r] >= 0.01, "#23803A", IF ( [@r] >= 0, "#A9E5AE", IF ( [@r] > -0.01, "#F2B5AE", "#C9402F" ) ) )
            VAR tc = IF ( ABS ( [@r] ) >= 0.01, "#fff", "#0F1712" )
            RETURN
                "<rect x='" & FORMAT ( [@x0] + 1, "0.0", "en-US" ) & "' y='0' width='" & FORMAT ( MAX ( w - 2, 1 ), "0.0", "en-US" ) & "' height='120' rx='6' fill='" & c & "'/>"
                & IF ( w > 40,
                    "<text x='" & FORMAT ( [@x0] + 8, "0.0", "en-US" ) & "' y='18' font-size='12' font-weight='800' fill='" & tc & "'>" & gold_fact_positions[symbol] & "</text>"
                    & "<text x='" & FORMAT ( [@x0] + 8, "0.0", "en-US" ) & "' y='110' font-size='12' font-weight='700' fill='" & tc & "'>" & FORMAT ( [@r], "+0.00%;-0.00%", "en-US" ) & "</text>" ),
            "", [@i], ASC )
        VAR _svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 900 120' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif'>" & _tiles & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Order Flow Sankey] =
        -- all orders → side → outcome; ribbon width = order count
        VAR _o = ADDCOLUMNS ( ALLSELECTED ( gold_fact_orders[side], gold_fact_orders[status] ), "@n", CALCULATE ( [Orders] ) )
        VAR _f = ADDCOLUMNS ( FILTER ( _o, [@n] > 0 ),
            "@s", SWITCH ( LOWER ( gold_fact_orders[side] ), "buy", 1, "sell", 2, 3 ),
            "@g", SWITCH ( LOWER ( gold_fact_orders[status] ), "filled", 1, "canceled", 2, "expired", 3, 4 ) )
        VAR _flows = GROUPBY ( _f, [@s], [@g], "@n", SUMX ( CURRENTGROUP (), [@n] ) )
        VAR _tot = SUMX ( _flows, [@n] )
        VAR _k = 180 / _tot          -- px per order
        VAR _gap = 10
        VAR _so = ADDCOLUMNS ( _flows,
            "@sy", VAR s = [@s] VAR g = [@g]
                   RETURN 10 + ( s - 1 ) * _gap + SUMX ( FILTER ( _flows, [@s] < s || ( [@s] = s && [@g] < g ) ), [@n] ) * _k,
            "@ty", VAR s = [@s] VAR g = [@g]
                   RETURN 10 + ( g - 1 ) * _gap + SUMX ( FILTER ( _flows, [@g] < g || ( [@g] = g && [@s] < s ) ), [@n] ) * _k )
        VAR _ribbons = CONCATENATEX ( _so,
            VAR h = [@n] * _k
            VAR c = SWITCH ( [@g], 1, "#23803A", 2, "#BFC8C0", 3, "#C9402F", "#F2B5AE" )
            RETURN "<path d='M300," & FORMAT ( [@sy], "0.0", "en-US" ) & " C450," & FORMAT ( [@sy], "0.0", "en-US" ) & " 450," & FORMAT ( [@ty], "0.0", "en-US" ) & " 600," & FORMAT ( [@ty], "0.0", "en-US" )
                & " L600," & FORMAT ( [@ty] + h, "0.0", "en-US" ) & " C450," & FORMAT ( [@ty] + h, "0.0", "en-US" ) & " 450," & FORMAT ( [@sy] + h, "0.0", "en-US" ) & " 300," & FORMAT ( [@sy] + h, "0.0", "en-US" ) & " Z' fill='" & c & "' fill-opacity='.45'/>",
            "" )
        VAR _nodes =
            CONCATENATEX ( GROUPBY ( _so, [@s] ),
                VAR s = [@s] VAR n = SUMX ( FILTER ( _flows, [@s] = s ), [@n] )
                VAR y = MINX ( FILTER ( _so, [@s] = s ), [@sy] )
                RETURN "<rect x='292' y='" & FORMAT ( y, "0.0", "en-US" ) & "' width='8' height='" & FORMAT ( n * _k, "0.0", "en-US" ) & "' fill='#0F1712'/>"
                    & "<text x='286' y='" & FORMAT ( y + n * _k / 2 + 4, "0.0", "en-US" ) & "' font-size='11' text-anchor='end' fill='#0F1712'>" & SWITCH ( s, 1, "Buy", 2, "Sell", "Other" ) & " " & n & "</text>", "" )
            & CONCATENATEX ( GROUPBY ( _so, [@g] ),
                VAR g = [@g] VAR n = SUMX ( FILTER ( _flows, [@g] = g ), [@n] )
                VAR y = MINX ( FILTER ( _so, [@g] = g ), [@ty] )
                RETURN "<rect x='600' y='" & FORMAT ( y, "0.0", "en-US" ) & "' width='8' height='" & FORMAT ( n * _k, "0.0", "en-US" ) & "' fill='" & SWITCH ( g, 1, "#23803A", 2, "#9AA39C", 3, "#C9402F", "#F2B5AE" ) & "'/>"
                    & "<text x='616' y='" & FORMAT ( y + n * _k / 2 + 4, "0.0", "en-US" ) & "' font-size='11' fill='#0F1712'>" & SWITCH ( g, 1, "Filled", 2, "Canceled", 3, "Expired", "Working" ) & " " & n
                    & " (" & FORMAT ( n / _tot, "0%" ) & ")</text>", "" )
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 760 240' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif'>"
                & "<rect x='150' y='10' width='8' height='" & FORMAT ( 180 + 2 * _gap, "0", "en-US" ) & "' fill='#0F1712'/>"
                & "<text x='140' y='110' font-size='18' font-weight='800' text-anchor='end' fill='#0F1712'>" & _tot & "</text>"
                & "<text x='140' y='126' font-size='12' text-anchor='end' fill='#5E685F'>orders</text>"
                & _ribbons & _nodes & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Cash Donut] =
        VAR _p = [Capital Deployed %]
        VAR _r = 40  VAR _c = 2 * PI () * _r
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif'>"
                & "<circle cx='50' cy='50' r='40' fill='none' stroke='#E3E8E3' stroke-width='9'/>"
                & "<circle cx='50' cy='50' r='40' fill='none' stroke='#23803A' stroke-width='9' stroke-linecap='round'"
                & " stroke-dasharray='" & FORMAT ( _p * _c, "0.0", "en-US" ) & " " & FORMAT ( _c, "0.0", "en-US" ) & "' transform='rotate(-90 50 50)'/>"
                & "<text x='50' y='54' font-size='16' font-weight='800' text-anchor='middle' fill='#0F1712'>" & FORMAT ( _p, "0%" ) & "</text>"
                & "<text x='50' y='66' font-size='9' font-weight='700' text-anchor='middle' fill='#5E685F'>INVESTED</text></svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Market Coverage] =
        VAR _eq = DIVIDE ( [Equities Priced], [Equities Tracked] )
        VAR _cr = DIVIDE ( [Crypto Priced], [Crypto Pairs Tracked] )
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 60' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif' font-size='11'>"
                & "<text x='0' y='14' fill='#fff' font-weight='700'>Equities</text>"
                & "<rect x='80' y='6' width='260' height='8' rx='4' fill='rgba(255,255,255,.12)'/><rect x='80' y='6' width='" & FORMAT ( 260 * _eq, "0", "en-US" ) & "' height='8' rx='4' fill='#4ED15A'/>"
                & "<text x='400' y='14' text-anchor='end' fill='#4ED15A' font-weight='700'>" & [Equities Priced] & "/" & [Equities Tracked] & "</text>"
                & "<text x='0' y='44' fill='#fff' font-weight='700'>Crypto</text>"
                & "<rect x='80' y='36' width='260' height='8' rx='4' fill='rgba(255,255,255,.12)'/><rect x='80' y='36' width='" & FORMAT ( 260 * _cr, "0", "en-US" ) & "' height='8' rx='4' fill='#C9402F'/>"
                & "<text x='400' y='44' text-anchor='end' fill='#C9402F' font-weight='700'>" & [Crypto Priced] & "/" & [Crypto Pairs Tracked] & "</text>"
                & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Card Equity Curve] =
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 884 340' font-family='Plus Jakarta Sans,Segoe UI,sans-serif'>"
                & "<rect width='884' height='340' rx='20' fill='#FFFFFF' stroke='#E3E8E3'/>"
                & "<text x='28' y='44' font-family='Georgia,Cambria,Times New Roman,serif' font-size='23' font-weight='700' fill='#0F1712'>" & "Equity curve &amp; drawdown" & "</text>"
                & "<text x='28' y='68' font-size='13' fill='#5E685F'>" & "Cumulative closed P&amp;L by day · shaded = distance below the running peak" & "</text>"
                & "<rect x='736' y='22' width='120' height='26' rx='13' fill='#E3F5E5'/><text x='796.0' y='39.0' font-size='12' font-weight='700' text-anchor='middle' fill='#23803A'>" & "Daily · closed" & "</text>"
                & "<svg x='28' y='88' width='828' height='232'>" & SUBSTITUTE ( SUBSTITUTE ( MID ( [SVG - Equity Curve & Drawdown], 25, 100000 ), "%23", "#" ), "%25", "%" ) & "</svg>"
                & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Card Waterfall] =
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 884 358' font-family='Plus Jakarta Sans,Segoe UI,sans-serif'>"
                & "<rect width='884' height='358' rx='20' fill='#FFFFFF' stroke='#E3E8E3'/>"
                & "<text x='28' y='44' font-family='Georgia,Cambria,Times New Roman,serif' font-size='23' font-weight='700' fill='#0F1712'>" & [Title - The Book] & "</text>"
                & "<text x='28' y='68' font-size='13' fill='#5E685F'>" & "P&amp;L waterfall · stop exits alone erase more than half of all gains" & "</text>"
                & "<rect x='686' y='22' width='170' height='26' rx='13' fill='#FDE7E4'/><text x='771.0' y='39.0' font-size='12' font-weight='700' text-anchor='middle' fill='#C9402F'>" & "Stops = " & FORMAT ( [Stop Share of Gains], "0%" ) & " of gains" & "</text>"
                & "<svg x='28' y='100' width='828' height='230'>" & SUBSTITUTE ( SUBSTITUTE ( MID ( [SVG - P&L Waterfall], 25, 100000 ), "%23", "#" ), "%25", "%" ) & "</svg>"
                & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Card Crypto] =
        -- dark card: weekly cumulative lines + one bar per asset class
        VAR _c = [Crypto P&L]  VAR _e = [Equity P&L]  VAR _o = [Options P&L]
        VAR _mx = MAX ( ABS ( _c ), MAX ( ABS ( _e ), ABS ( _o ) ) )
        VAR _bar = 560
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 884 358' font-family='Plus Jakarta Sans,Segoe UI,sans-serif'>"
                & "<rect width='884' height='358' rx='20' fill='#0F1712'/>"
                & "<text x='28' y='44' font-family='Georgia,Cambria,Times New Roman,serif' font-size='23' font-weight='700' fill='#FFFFFF'>" & IF ( _c > MAX ( _e, _o ), "Only crypto pays", "Crypto is not the winner" ) & "</text>"
                & "<text x='28' y='68' font-size='13' fill='rgba(255,255,255,.6)'>Cumulative P&amp;L by week</text>"
                & "<rect x='776' y='22' width='80' height='26' rx='13' fill='#FFFFFF'/><text x='816' y='39' font-size='12' font-weight='700' text-anchor='middle' fill='#0F1712'>By asset</text>"
                & "<svg x='28' y='76' width='828' height='178'>" & SUBSTITUTE ( SUBSTITUTE ( MID ( [SVG - Crypto vs Equity Weekly], 25, 100000 ), "%23", "#" ), "%25", "%" ) & "</svg>"
                & "<text x='28' y='276' font-size='12' font-weight='700' fill='#FFFFFF'>Crypto</text>"
                & "<rect x='110' y='268' width='" & FORMAT ( _bar * ABS ( _c ) / _mx, "0.0", "en-US" ) & "' height='9' rx='4.5' fill='#4ED15A'/>"
                & "<text x='856' y='276' font-size='12' font-weight='700' text-anchor='end' fill='#4ED15A'>" & FORMAT ( _c, "+$#,0;-$#,0", "en-US" ) & "</text>"
                & "<text x='28' y='298' font-size='12' font-weight='700' fill='#FFFFFF'>Equity</text>"
                & "<rect x='110' y='290' width='" & FORMAT ( _bar * ABS ( _e ) / _mx, "0.0", "en-US" ) & "' height='9' rx='4.5' fill='#C9402F'/>"
                & "<text x='856' y='298' font-size='12' font-weight='700' text-anchor='end' fill='#C9402F'>" & FORMAT ( _e, "+$#,0;-$#,0", "en-US" ) & "</text>"
                & "<text x='28' y='320' font-size='12' font-weight='700' fill='#FFFFFF'>Options</text>"
                & "<rect x='110' y='312' width='" & FORMAT ( _bar * ABS ( _o ) / _mx, "0.0", "en-US" ) & "' height='9' rx='4.5' fill='#C9402F'/>"
                & "<text x='856' y='320' font-size='12' font-weight='700' text-anchor='end' fill='#C9402F'>" & FORMAT ( _o, "+$#,0;-$#,0", "en-US" ) & "</text>"
                & "<text x='28' y='344' font-size='11' fill='rgba(255,255,255,.55)'>" & FORMAT ( [Crypto Trades], "#,0" ) & " crypto trades · " & FORMAT ( [Crypto Win Rate], "0%" ) & " win · PF " & FORMAT ( [Crypto Profit Factor], "0.00", "en-US" ) & "</text>"
                & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

    MEASURE gold_fact_trades[SVG - Header The Book] =
        VAR _chip = FORMAT ( [First Trade Date], "d mmm", "en-US" ) & " – " & FORMAT ( [Last Trade Date], "d mmm yyyy", "en-US" )
        VAR _cw = 28 + LEN ( _chip ) * 8.2
        VAR _svg =
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1792 96' font-family='Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif'>"
                & "<text x='0' y='48' font-family='Georgia,Cambria,Times New Roman,serif' font-size='42' font-weight='700' letter-spacing='-.5' fill='#0F1712'>The Book</text>"
                & "<text x='2' y='80' font-size='15' fill='#5E685F'>" & [Subtitle - The Book] & "</text>"
                & "<rect x='" & FORMAT ( 1792 - _cw - 186, "0", "en-US" ) & "' y='26' width='174' height='42' rx='21' fill='#FFFFFF' stroke='#E3E8E3'/>"
                & "<circle cx='" & FORMAT ( 1792 - _cw - 164, "0", "en-US" ) & "' cy='47' r='5' fill='#F2B33D'/>"
                & "<text x='" & FORMAT ( 1792 - _cw - 150, "0", "en-US" ) & "' y='52' font-size='14' font-weight='700' fill='#0F1712'>Alpaca · Paper</text>"
                & "<rect x='" & FORMAT ( 1792 - _cw, "0", "en-US" ) & "' y='26' width='" & FORMAT ( _cw, "0", "en-US" ) & "' height='42' rx='21' fill='#0F1712'/>"
                & "<text x='" & FORMAT ( 1792 - _cw / 2, "0", "en-US" ) & "' y='52' font-size='14' font-weight='700' text-anchor='middle' fill='#FFFFFF'>" & _chip & "</text>"
                & "</svg>"
        RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( SUBSTITUTE ( _svg, "%", "%25" ), "#", "%23" )  -- URI-encode % first, then #

