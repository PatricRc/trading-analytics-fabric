-- Measure: SVG - R-Multiple Dots
-- Report: Trading Analytics (The Book · The Edge · The Desk)
-- Table: gold_fact_trades
-- Display folder: 06-svg-visuals

-- every dot is a trade, binned to the nearest 0.5R (clamped to -2.5R … +3R)
VAR _tr = ADDCOLUMNS (
    FILTER ( ALLSELECTED ( gold_fact_trades ), NOT ISBLANK ( gold_fact_trades[r] ) ),
    "@b", MIN ( 3, MAX ( -2.5, ROUND ( gold_fact_trades[r] * 2, 0 ) / 2 ) ) )
VAR _bins = SELECTCOLUMNS ( GENERATESERIES ( -5, 6, 1 ), "@bin", [Value] / 2 )
VAR _cnt = ADDCOLUMNS ( _bins, "@n", VAR b = [@bin] RETURN COUNTROWS ( FILTER ( _tr, [@b] = b ) ) + 0 )
VAR _cols = CONCATENATEX ( _cnt,
    VAR b = [@bin]  VAR n = [@n]
    VAR cx = 40 + ( b + 2.5 ) * 2 * 72
    VAR c = IF ( b < 0, "#E0574C", IF ( b = 0, "#BFC8C0", "#2E9E44" ) )
    VAR dots = CONCATENATEX ( GENERATESERIES ( 0, MAX ( 0, n - 1 ), 1 ),
        IF ( n > 0,
            "<circle cx='" & FORMAT ( cx - 15 + MOD ( [Value], 4 ) * 10, "0", "en-US" ) & "' cy='" & ( 180 - INT ( [Value] / 4 ) * 10 ) & "' r='4' fill='" & c & "'/>" ), "" )
    RETURN dots
        & "<text x='" & cx & "' y='" & ( 168 - INT ( MAX ( n - 1, 0 ) / 4 ) * 10 - 10 ) & "' font-size='10' font-weight='700' text-anchor='middle' fill='#0F1712'>" & n & "</text>"
        & "<text x='" & cx & "' y='202' font-size='10' text-anchor='middle' fill='#6A746C'>" & FORMAT ( b, "+0.0;-0.0;0", "en-US" ) & "R" & "</text>",
    "", [@bin], ASC )
VAR _svg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 900 210' font-family='Plus Jakarta Sans,Segoe UI'>"
        & "<line x1='0' x2='900' y1='188' y2='188' stroke='#E3E8E3'/>" & _cols & "</svg>"
RETURN "data:image/svg+xml;utf8," & SUBSTITUTE ( _svg, "#", "%23" )
