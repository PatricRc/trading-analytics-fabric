-- Measure: Card - Capital Deployed HTML
-- Report: Trading Analytics (The Book · The Edge · The Desk)
-- Table: gold_fact_trades
-- Display folder: 05-html-cards

VAR _val = FORMAT ( [Capital Deployed %], "0%" )
VAR _sub = "<b style='color:#4ED15A'>" & FORMAT ( [Position Market Value] / 1000, "$0.0", "en-US" ) & "K" & "</b> of " & FORMAT ( [Account Equity] / 1000, "$0.0", "en-US" ) & "K" & " equity"
VAR _color = "#FFFFFF"
RETURN
    "<div style='font-family:Plus Jakarta Sans,Segoe UI,sans-serif;border-radius:18px;padding:16px 18px;height:100%;box-sizing:border-box;position:relative;overflow:hidden;background:#0F1712;color:#FFFFFF'>"
        & "<div style='font-size:12px;font-weight:600;color:rgba(255,255,255,.62)'>Capital deployed</div>"
        & "<div style='font-size:34px;font-weight:800;letter-spacing:-.02em;margin-top:10px;color:" & _color & "'>" & _val & "</div>"
        & "<div style='font-size:11px;color:rgba(255,255,255,.62);margin-top:6px'>" & _sub & "</div>"
        & "</div>" 
