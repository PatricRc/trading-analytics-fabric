-- Measure: Card - Account Equity HTML
-- Report: Trading Analytics (The Book · The Edge · The Desk)
-- Table: gold_fact_trades
-- Display folder: 05-html-cards

VAR _val = FORMAT ( [Account Equity], "$#,0", "en-US" )
VAR _sub = "<span style='background:" & IF ( [Day P&L] < 0, "#E0574C", "#2E9E44" ) & ";color:#fff;border-radius:8px;padding:2px 7px;font-weight:700'>" & FORMAT ( [Day P&L], "+$#,0;-$#,0", "en-US" ) & "</span> today"
VAR _color = "#FFFFFF"
RETURN
    "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:18px;padding:18px 22px;height:156px;box-sizing:border-box;position:relative;overflow:hidden;background:#0F1712;color:#FFFFFF'>"
        & "<div style='font-size:14px;font-weight:600;color:rgba(255,255,255,.62)'>Account equity</div>"
        & "<div style='font-size:44px;font-weight:800;letter-spacing:-.02em;margin-top:14px;color:" & _color & "'>" & _val & "</div>"
        & "<div style='font-size:13px;color:rgba(255,255,255,.62);margin-top:8px'>" & _sub & "</div>" & "<div style='position:absolute;right:22px;bottom:22px;display:flex;gap:5px;align-items:flex-end;height:48px'>" & "<i style='width:9px;background:#E0574C;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Day P&L] ), MAX ( ABS ( [Day P&L] ), MAX ( ABS ( [Account Equity]/100 ), ABS ( [Account Equity]/200 ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:9px;background:#2E9E44;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Account Equity]/100 ), MAX ( ABS ( [Day P&L] ), MAX ( ABS ( [Account Equity]/100 ), ABS ( [Account Equity]/200 ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:9px;background:#4ED15A;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Account Equity]/200 ), MAX ( ABS ( [Day P&L] ), MAX ( ABS ( [Account Equity]/100 ), ABS ( [Account Equity]/200 ) ) ) ), "0", "en-US" ) & "px'></i>" & "</div>"
        & "</div>" 
