-- Measure: Card - Stop Exits HTML
-- Report: Trading Analytics (The Book · The Edge · The Desk)
-- Table: gold_fact_trades
-- Display folder: 05-html-cards

VAR _val = FORMAT ( [Stop Exits], "#,0" ) & " trades"
VAR _sub = FORMAT ( [Stop Exit Recovery %], "0%" ) & " recovered · " & FORMAT ( [Stop Exit P&L], "$#,0;-$#,0", "en-US" )
VAR _color = "#0F1712"
RETURN
    "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:20px;padding:20px 24px;height:156px;box-sizing:border-box;position:relative;overflow:hidden;font-variant-numeric:tabular-nums;background:#FFFFFF;color:#0F1712;border:1px solid #E3E8E3'>"
        & "<div style='font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:#5E685F'>Stop exits</div>"
        & "<div style='font-size:44px;font-weight:800;letter-spacing:-.025em;line-height:1;margin-top:18px;color:" & _color & "'>" & _val & "</div>"
        & "<div style='font-size:13px;color:#5E685F;margin-top:12px'>" & _sub & "</div>"
        & "</div>" 
