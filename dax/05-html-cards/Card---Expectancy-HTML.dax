-- Measure: Card - Expectancy HTML
-- Report: Trading Analytics (The Book · The Edge · The Desk)
-- Table: gold_fact_trades
-- Display folder: 05-html-cards

VAR _val = "<span style='font-size:22px;vertical-align:8px;margin-right:6px'>" & IF ( [Expectancy] < 0, "▼", "▲" ) & "</span>" & FORMAT ( [Expectancy], "$#,0.00;$#,0.00", "en-US" )
VAR _sub = FORMAT ( [Avg R], "+0.00;-0.00", "en-US" ) & "R" & " avg R-multiple"
VAR _color = "#FFFFFF"
RETURN
    "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:20px;padding:20px 24px;height:156px;box-sizing:border-box;position:relative;overflow:hidden;font-variant-numeric:tabular-nums;background:#0F1712;color:#FFFFFF'>"
        & "<div style='font-size:11px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:rgba(255,255,255,.66)'>Expectancy per trade</div>"
        & "<div style='font-size:44px;font-weight:800;letter-spacing:-.025em;line-height:1;margin-top:18px;color:" & _color & "'>" & _val & "</div>"
        & "<div style='font-size:13px;color:rgba(255,255,255,.66);margin-top:12px'>" & _sub & "</div>" & "<div style='position:absolute;right:22px;bottom:22px;display:flex;gap:5px;align-items:flex-end;height:48px'>" & "<i style='width:9px;background:#C9402F;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Gross Losses] ), MAX ( ABS ( [Gross Losses] ), MAX ( ABS ( [Gross Wins] ), ABS ( [Net P&L] ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:9px;background:#23803A;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Gross Wins] ), MAX ( ABS ( [Gross Losses] ), MAX ( ABS ( [Gross Wins] ), ABS ( [Net P&L] ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:9px;background:#4ED15A;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Net P&L] ), MAX ( ABS ( [Gross Losses] ), MAX ( ABS ( [Gross Wins] ), ABS ( [Net P&L] ) ) ) ), "0", "en-US" ) & "px'></i>" & "</div>"
        & "</div>" 
