-- Measure: Card - Expectancy HTML
-- Report: Trading Analytics (The Book · The Edge · The Desk)
-- Table: gold_fact_trades
-- Display folder: 05-html-cards

VAR _val = FORMAT ( [Expectancy], "+$#,0.00;-$#,0.00", "en-US" )
VAR _sub = FORMAT ( [Avg R], "+0.00;-0.00", "en-US" ) & "R" & " avg R-multiple"
VAR _color = "#FFFFFF"
RETURN
    "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:18px;padding:18px 22px;height:156px;box-sizing:border-box;position:relative;overflow:hidden;background:#0F1712;color:#FFFFFF'>"
        & "<div style='font-size:14px;font-weight:600;color:rgba(255,255,255,.62)'>Expectancy per trade</div>"
        & "<div style='font-size:44px;font-weight:800;letter-spacing:-.02em;margin-top:14px;color:" & _color & "'>" & _val & "</div>"
        & "<div style='font-size:13px;color:rgba(255,255,255,.62);margin-top:8px'>" & _sub & "</div>" & "<div style='position:absolute;right:22px;bottom:22px;display:flex;gap:5px;align-items:flex-end;height:48px'>" & "<i style='width:9px;background:#E0574C;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Gross Losses] ), MAX ( ABS ( [Gross Losses] ), MAX ( ABS ( [Gross Wins] ), ABS ( [Net P&L] ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:9px;background:#2E9E44;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Gross Wins] ), MAX ( ABS ( [Gross Losses] ), MAX ( ABS ( [Gross Wins] ), ABS ( [Net P&L] ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:9px;background:#4ED15A;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Net P&L] ), MAX ( ABS ( [Gross Losses] ), MAX ( ABS ( [Gross Wins] ), ABS ( [Net P&L] ) ) ) ), "0", "en-US" ) & "px'></i>" & "</div>"
        & "</div>" 
