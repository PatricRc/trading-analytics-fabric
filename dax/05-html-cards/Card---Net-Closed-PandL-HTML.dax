-- Measure: Card - Net Closed P&L HTML
-- Report: Trading Analytics (The Book · The Edge · The Desk)
-- Table: gold_fact_trades
-- Display folder: 05-html-cards

VAR _val = FORMAT ( [Net P&L], "+$#,0;-$#,0", "en-US" )
VAR _sub = "crypto · equity · options"
VAR _color = IF ( [Net P&L] < 0, "#E0574C", "#2E9E44" )
RETURN
    "<div style='font-family:Plus Jakarta Sans,Segoe UI,Helvetica,Arial,sans-serif;border-radius:18px;padding:18px 22px;height:156px;box-sizing:border-box;position:relative;overflow:hidden;background:#FFFFFF;color:#0F1712'>"
        & "<div style='font-size:14px;font-weight:600;color:#6A746C'>Net closed P&L</div>"
        & "<div style='font-size:44px;font-weight:800;letter-spacing:-.02em;margin-top:14px;color:" & _color & "'>" & _val & "</div>"
        & "<div style='font-size:13px;color:#6A746C;margin-top:8px'>" & _sub & "</div>" & "<div style='position:absolute;right:22px;bottom:22px;display:flex;gap:5px;align-items:flex-end;height:48px'>" & "<i style='width:9px;background:#E0574C;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Options P&L] ), MAX ( ABS ( [Options P&L] ), MAX ( ABS ( [Equity P&L] ), ABS ( [Crypto P&L] ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:9px;background:#2E9E44;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Equity P&L] ), MAX ( ABS ( [Options P&L] ), MAX ( ABS ( [Equity P&L] ), ABS ( [Crypto P&L] ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:9px;background:#4ED15A;height:" & FORMAT ( 48 * DIVIDE ( ABS ( [Crypto P&L] ), MAX ( ABS ( [Options P&L] ), MAX ( ABS ( [Equity P&L] ), ABS ( [Crypto P&L] ) ) ) ), "0", "en-US" ) & "px'></i>" & "</div>"
        & "</div>" 
