-- Measure: Card - Net Closed P&L HTML
-- Report: Trading Analytics (The Book · The Edge · The Desk)
-- Table: gold_fact_trades
-- Display folder: 05-html-cards

VAR _val = FORMAT ( [Net P&L], "+$#,0;-$#,0", "en-US" )
VAR _sub = "crypto · equity · options"
VAR _color = IF ( [Net P&L] < 0, "#E0574C", "#2E9E44" )
RETURN
    "<div style='font-family:Plus Jakarta Sans,Segoe UI,sans-serif;border-radius:18px;padding:16px 18px;height:100%;box-sizing:border-box;position:relative;overflow:hidden;background:#FFFFFF;color:#0F1712'>"
        & "<div style='font-size:12px;font-weight:600;color:#6A746C'>Net closed P&L</div>"
        & "<div style='font-size:34px;font-weight:800;letter-spacing:-.02em;margin-top:10px;color:" & _color & "'>" & _val & "</div>"
        & "<div style='font-size:11px;color:#6A746C;margin-top:6px'>" & _sub & "</div>" & "<div style='position:absolute;right:18px;bottom:16px;display:flex;gap:4px;align-items:flex-end;height:34px'>" & "<i style='width:7px;background:#E0574C;height:" & FORMAT ( 34 * DIVIDE ( ABS ( [Options P&L] ), MAX ( ABS ( [Options P&L] ), MAX ( ABS ( [Equity P&L] ), ABS ( [Crypto P&L] ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:7px;background:#2E9E44;height:" & FORMAT ( 34 * DIVIDE ( ABS ( [Equity P&L] ), MAX ( ABS ( [Options P&L] ), MAX ( ABS ( [Equity P&L] ), ABS ( [Crypto P&L] ) ) ) ), "0", "en-US" ) & "px'></i>" & "<i style='width:7px;background:#4ED15A;height:" & FORMAT ( 34 * DIVIDE ( ABS ( [Crypto P&L] ), MAX ( ABS ( [Options P&L] ), MAX ( ABS ( [Equity P&L] ), ABS ( [Crypto P&L] ) ) ) ), "0", "en-US" ) & "px'></i>" & "</div>"
        & "</div>" 
