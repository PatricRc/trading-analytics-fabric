-- Measure: Peak Cumulative P&L
-- Report: Trading Analytics (The Book · The Edge · The Desk)
-- Table: gold_fact_trades
-- Display folder: 01-base
-- Format string: $#,0;-$#,0;$0

-- running high-water mark; the account starts at 0 so the peak never goes below 0
VAR _d = MAX ( gold_dim_date[Date] )
VAR _peak =
    MAXX (
        FILTER ( ALLSELECTED ( gold_dim_date[Date] ), gold_dim_date[Date] <= _d ),
        [Cumulative P&L]
    )
RETURN MAX ( _peak, 0 )
